#!/usr/bin/env bash
set -euo pipefail

# Parallax engine API — Grok (Composer), READ-ONLY.
#
# Safety model (verified grok 0.2.32, 2026-06-08):
#   * The OS-level SANDBOX is the real read-only guarantee. `--sandbox read-only`
#     uses kernel primitives (Seatbelt on macOS, Landlock on Linux): grok may read
#     anywhere but can write ONLY to ~/.grok + temp — never the target repo. Write
#     attempts are kernel-denied and recorded in ~/.grok/sandbox-events.jsonl.
#   * `--permission-mode bypassPermissions` is required for the run to COMPLETE in
#     headless mode: grok's CLI only enforces bypassPermissions/default; `plan` is
#     accepted but NOT enforced and falls back to interactive prompting, which
#     CANCELS the turn (truncated/empty findings). The sandbox, not the permission
#     mode, is the read-only guarantee. Never --yolo.

usage() {
  cat <<'EOF'
plx-grok-ro — run Grok (Composer) headless, READ-ONLY, against a repo (Parallax engine API)

Usage:
  plx-grok-ro --repo <abs-path> --prompt-file <file> --stdout
  plx-grok-ro --repo <abs-path> --prompt-file <file> --out <file> --log <file>

What it does:
  One non-interactive grok turn with safety pinned: kernel-enforced `read-only`
  sandbox (Seatbelt/Landlock — grok physically cannot write the repo) and
  bypassPermissions so the headless turn runs to completion (other permission
  modes silently cancel tool calls in headless). Requests grok's JSON output
  internally and emits ONLY the model's final text — never the JSON envelope.

Flags:
  --repo <dir>          absolute path to the target repo (required)
  --prompt-file <file>  file containing the full prompt (required)
  --stdout              print grok's final text to stdout; temp files auto-cleaned
  --out <f> --log <f>   instead of --stdout: write final text / stderr log to files
  --help                this text

Caller notes (important):
  * Run this tool with the Claude Bash sandbox DISABLED for the call
    (dangerouslyDisableSandbox: true) — grok needs network/keychain access the
    sandbox blocks. The kernel read-only sandbox still confines grok itself.
  * TRUST THE EXIT CODE, not stderr: grok prints non-fatal
    `worker quit ... AuthorizationRequired` lines to stderr even on success.

Exit codes:
  0  success — stdout (or --out) holds grok's final text
  1  grok failure — cancelled turn, empty output, or non-zero grok exit
  2  usage error — bad flags or missing/empty inputs
  3  not signed in — tell the user to run `grok login` (or export XAI_API_KEY)
EOF
}

REPO=""
PROMPT=""
OUT=""
LOG=""
STDOUT=0
TMP_DIR=""

cleanup() { if [[ -n "$TMP_DIR" ]]; then rm -rf "$TMP_DIR"; fi; }
trap cleanup EXIT

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --prompt-file) need_value "$1" "${2:-}"; PROMPT="$2"; shift 2 ;;
    --out) need_value "$1" "${2:-}"; OUT="$2"; shift 2 ;;
    --log) need_value "$1" "${2:-}"; LOG="$2"; shift 2 ;;
    --stdout) STDOUT=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

[[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
[[ -s "$PROMPT" ]] || { echo "prompt file missing/empty: $PROMPT" >&2; exit 2; }

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/parallax-grok.XXXXXX")"
RAW="$TMP_DIR/raw.json"
if [[ "$STDOUT" -eq 1 ]]; then
  OUT="$TMP_DIR/output.txt"
  LOG="$TMP_DIR/grok.log"
else
  [[ -n "$OUT" ]] || { echo "--out required (or use --stdout)" >&2; exit 2; }
  [[ -n "$LOG" ]] || { echo "--log required (or use --stdout)" >&2; exit 2; }
fi

mkdir -p "$(dirname "$OUT")" "$(dirname "$LOG")"

set +e
grok --cwd "$REPO" --permission-mode bypassPermissions --sandbox read-only \
  --no-alt-screen --output-format json \
  --prompt-file "$PROMPT" > "$RAW" 2> "$LOG"
rc=$?
set -e

# Genuine "not signed in" prints the OAuth sign-in prompt to stderr. This is the
# real login signal — NOT the AuthorizationRequired worker noise, which also
# appears on success.
if grep -qiE "Open this URL to sign in|Signing in with Grok" "$LOG"; then
  echo "plx-grok-ro: not authenticated — run \`grok login\` (or export XAI_API_KEY), then retry." >&2
  exit 3
fi

if [[ $rc -ne 0 ]]; then
  echo "grok invocation failed (exit $rc)" >&2
  [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
  exit 1
fi

set +e
STOP="$(python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("stopReason") or "")
except Exception:
    print("")' "$RAW")"
TEXT="$(python3 -c 'import json,sys
try:
    sys.stdout.write(json.load(open(sys.argv[1])).get("text") or "")
except Exception:
    sys.exit(7)' "$RAW")"
pyrc=$?
set -e

if [[ $pyrc -ne 0 ]]; then
  # JSON parse failed (unexpected grok output shape) — fall back to raw text.
  TEXT="$(cat "$RAW")"
fi

if [[ "$STOP" == "Cancelled" ]]; then
  echo "plx-grok-ro: turn was Cancelled — review did not complete (a tool call was gated)." >&2
  echo "plx-grok-ro: expected only if bypassPermissions is not taking effect (check grok version)." >&2
  exit 1
fi

[[ -n "$TEXT" ]] || { echo "plx-grok-ro: empty output (stopReason=$STOP)" >&2; exit 1; }

printf '%s\n' "$TEXT" > "$OUT"

if [[ "$STDOUT" -eq 1 ]]; then
  cat "$OUT"
else
  echo "OK plx-grok-ro out=$OUT log=$LOG"
fi
