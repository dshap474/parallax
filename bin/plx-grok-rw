#!/usr/bin/env bash
set -euo pipefail

# Parallax engine API — Grok (Composer), WRITE-CAPABLE. Used when the writer
# (`code`) role is assigned to grok, and by the /plx:grok passthrough (the
# orchestrator runs this wrapper directly).
#
# Safety model (verified grok 0.2.32, 2026-06-08):
#   * The OS-level SANDBOX is the real boundary. `--sandbox workspace` confines
#     writes to the repo (CWD) + ~/.grok + temp via kernel primitives (Seatbelt
#     on macOS, Landlock on Linux). Escape attempts are kernel-denied and logged
#     to ~/.grok/sandbox-events.jsonl. Enforced regardless of permission mode.
#   * `--permission-mode bypassPermissions` is required: grok's CLI only enforces
#     bypassPermissions/default. acceptEdits/dontAsk/plan are accepted but NOT
#     enforced — they fall back to interactive prompting, which in headless mode
#     CANCELS the tool call and writes nothing (the old "grok writing doesn't
#     work" bug). bypassPermissions still honors --deny rules and PreToolUse
#     hooks. Net: edits actually apply AND stay scoped to the repo. Never --yolo.

usage() {
  cat <<'EOF'
plx-grok-rw — run Grok (Composer) headless, WRITE-CAPABLE (repo-scoped), against a repo (Parallax engine API)

Usage:
  plx-grok-rw --repo <abs-path> --prompt-file <file> --stdout
  plx-grok-rw --repo <abs-path> --prompt-file <file> --out <file> --log <file>

What it does:
  One non-interactive grok turn that MAY EDIT files, with safety pinned:
  kernel-enforced `workspace` sandbox (edits confined to --repo; writes outside
  it are denied by the OS) and bypassPermissions so headless edits actually
  apply (other permission modes silently cancel them). Emits ONLY the model's
  final message — recovered from grok's session store (last assistant record),
  since the JSON envelope's text field aggregates narration and subagent
  streams; falls back to the envelope text if the session store can't be read.
  For a pure question/plan prompt grok simply writes nothing.

Flags:
  --repo <dir>          absolute path to the target repo (required; the write boundary)
  --prompt-file <file>  file containing the full prompt/spec (required)
  --stdout              print grok's final text to stdout; temp files auto-cleaned
  --out <f> --log <f>   instead of --stdout: write final text / stderr log to files
  --help                this text

Caller notes (important):
  * Run this tool with the Claude Bash sandbox DISABLED for the call
    (dangerouslyDisableSandbox: true) — grok needs network/keychain access the
    sandbox blocks. The kernel workspace sandbox still confines grok's writes.
  * TRUST THE EXIT CODE, not stderr: grok prints non-fatal
    `worker quit ... AuthorizationRequired` lines to stderr even on success.

After it returns:
  Inspect what changed with `git -C <repo> status --short` / `git -C <repo> diff`.

Exit codes:
  0  success — grok finished (check the diff for edits)
  1  grok failure — cancelled turn (no edits were applied), empty output, or non-zero grok exit
  2  usage error — bad flags or missing/empty inputs
  3  not signed in — tell the user to run `grok login` (or export XAI_API_KEY)
EOF
}

REPO=""
PROMPT=""
OUT=""
LOG=""
STDOUT=0
TMP_DIR=""

cleanup() { if [[ -n "$TMP_DIR" ]]; then rm -rf "$TMP_DIR"; fi; }
trap cleanup EXIT

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --prompt-file) need_value "$1" "${2:-}"; PROMPT="$2"; shift 2 ;;
    --out) need_value "$1" "${2:-}"; OUT="$2"; shift 2 ;;
    --log) need_value "$1" "${2:-}"; LOG="$2"; shift 2 ;;
    --stdout) STDOUT=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

[[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
[[ -s "$PROMPT" ]] || { echo "prompt file missing/empty: $PROMPT" >&2; exit 2; }

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/parallax-grok-rw.XXXXXX")"
RAW="$TMP_DIR/raw.json"
if [[ "$STDOUT" -eq 1 ]]; then
  OUT="$TMP_DIR/output.txt"
  LOG="$TMP_DIR/grok.log"
else
  [[ -n "$OUT" ]] || { echo "--out required (or use --stdout)" >&2; exit 2; }
  [[ -n "$LOG" ]] || { echo "--log required (or use --stdout)" >&2; exit 2; }
fi

mkdir -p "$(dirname "$OUT")" "$(dirname "$LOG")"

set +e
grok --cwd "$REPO" --permission-mode bypassPermissions --sandbox workspace \
  --no-alt-screen --output-format json \
  --prompt-file "$PROMPT" > "$RAW" 2> "$LOG"
rc=$?
set -e

if grep -qiE "Open this URL to sign in|Signing in with Grok" "$LOG"; then
  echo "plx-grok-rw: not authenticated — run \`grok login\` (or export XAI_API_KEY), then retry." >&2
  exit 3
fi

if [[ $rc -ne 0 ]]; then
  echo "grok invocation failed (exit $rc)" >&2
  [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
  exit 1
fi

set +e
STOP="$(python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("stopReason") or "")
except Exception:
    print("")' "$RAW")"
TEXT="$(python3 -c 'import json,sys
try:
    sys.stdout.write(json.load(open(sys.argv[1])).get("text") or "")
except Exception:
    sys.exit(7)' "$RAW")"
pyrc=$?
set -e

if [[ $pyrc -ne 0 ]]; then
  # JSON parse failed (unexpected grok output shape) — fall back to raw text.
  TEXT="$(cat "$RAW")"
fi

if [[ "$STOP" == "Cancelled" ]]; then
  echo "plx-grok-rw: turn was Cancelled — a tool call was gated, not auto-approved." >&2
  echo "plx-grok-rw: expected only if bypassPermissions is not taking effect; no edits were applied." >&2
  exit 1
fi

[[ -n "$TEXT" ]] || { echo "plx-grok-rw: empty output (stopReason=$STOP)" >&2; exit 1; }

# The envelope `text` aggregates EVERY text chunk grok emitted during the turn —
# parallel subagent streams interleave into it (mid-word) and pre-tool-call
# narration prepends to it. The session store keeps proper message records; the
# last assistant record is the true final message. Prefer it; fall back to the
# envelope text on any miss. (Verified grok 0.2.39, 2026-06-11:
# tests/evals/2026-06-11_grok-output-aggregation-eval.md)
FINAL="$(python3 -c 'import json,os,sys,urllib.parse
try:
    sid = json.load(open(sys.argv[1])).get("sessionId") or ""
    if not sid:
        sys.exit(0)
    repo = os.path.realpath(sys.argv[2])
    path = os.path.join(os.path.expanduser("~/.grok/sessions"),
                        urllib.parse.quote(repo, safe=""), sid, "chat_history.jsonl")
    last = None
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            m = json.loads(line)
            if m.get("type") == "assistant":
                last = m
    c = (last or {}).get("content")
    if isinstance(c, str) and c.strip():
        sys.stdout.write(c)
except Exception:
    pass' "$RAW" "$REPO")"
[[ -n "$FINAL" ]] && TEXT="$FINAL"

printf '%s\n' "$TEXT" > "$OUT"

if [[ "$STDOUT" -eq 1 ]]; then
  cat "$OUT"
else
  echo "OK plx-grok-rw out=$OUT log=$LOG"
fi
