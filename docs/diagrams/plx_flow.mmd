%% Parallax dual-host pipeline overview.
%% Usage: render with any Mermaid flowchart-compatible renderer.
flowchart TD
    U([User request]) --> H{Host plugin}
    H -->|Claude Code /plx:*| C[Claude orchestrator]
    H -->|Codex $plx:skill| X[Codex orchestrator]

    C --> W{Workflow}
    X --> W

    W -->|dev| P[Host plans]
    P --> CR[One opposite-host plan review]
    CR --> B[One same-host Build worker]
    B --> V[Worker implements and verifies]
    V --> R[Parallel Grok 4.5 Medium review lanes]
    R --> S[Host verifies findings and fixes confirmed issues]

    SB[(shared/bin + shared/prompts)] -. synchronized copies .-> C
    SB -. synchronized copies .-> X

    classDef host fill:#1e3a5f,stroke:#78b7ff,color:#fff
    classDef lane fill:#243447,stroke:#9ab6d3,color:#fff
    classDef shared fill:#174c45,stroke:#6de0c9,color:#fff
    class C,X host
    class P,CR,B,V,R,S lane
    class SB shared
