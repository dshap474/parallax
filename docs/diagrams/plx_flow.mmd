flowchart TD
    U(["👤 User: an explicit /plx:* command «task»"]) --> SKL["📋 SKILL.md loads the request"]
    SKL --> IN["⚙️ Bootstrap — orchestrator (Fable) resolves with its own tools<br/>absolute repo root · dirty-worktree check"]
    IN --> RT{"🧭 Which pipeline the command runs"}

    RT -->|"/plx:dev — build a change"| DEV["🛠️ dev — full 10-step pipeline"]
    RT -->|"/plx:plan — think only, no edits"| PL["📐 plan — steps 1–3"]
    RT -->|"/plx:review — audit / debug, no edits"| RV["🔎 review — steps 6–8"]

    CFG[("🗂️ config/parallax.yaml<br/>engine-per-role: dev · plan · review<br/>→ resolves each lane's persona")] -. "binds lanes" .-> DEV
    CFG -. .-> PL
    CFG -. .-> RV

    DEV --> PIPE

    subgraph PIPE ["🔁 dev pipeline — 6 subagent spawns; Fable holds only compact artifacts"]
      direction TB
      S1["① Delegate planning — 2 parallel planners (read-only)<br/>plx:claude-planner (Opus xhigh) + plx:codex-planner (Codex xhigh)"]
      S2["② Plan artifacts return"]
      S3["③ 🧠 Fable synthesizes the final plan (judgment, not a merge)"]
      S4["④ Delegate the build — 1 worker ✍️<br/>plx:claude-worker (Opus xhigh), spec only"]
      S5["⑤ Buildout report returns — per-file summaries, never code bodies"]
      S6["⑥ Fable writes the review brief — WITHOUT reading the built code"]
      S7["⑦ 2 parallel Codex review lanes (read-only)<br/>correctness · refine"]
      S8["⑧ 🧠 Fable synthesizes as pseudo-3rd reviewer → repair plan<br/>verifies findings surgically, kills false positives"]
      S9["⑨ Fable applies the repair plan inline ✍️<br/>escape hatch: structural rework → fresh build"]
      S1 --> S2 --> S3 --> S4 --> S5 --> S6 --> S7 --> S8 --> S9
    end

    PIPE --> V["✅ Verify — run the repo's own checks<br/>ruff · pytest · npm · cargo …"]
    V --> DOC["⑩ Docs subagent updates docs → LOCAL commit only<br/>never push / PR / publish"]
    DOC --> REP(["📝 Final chat report"])

    PL -.->|"plan = dev steps ①–③"| S1
    RV -.->|"review = dev steps ⑥–⑧, read-only"| S6

    subgraph LEG ["Pipelines = subsets of the dev steps"]
      direction TB
      L1["🛠️ dev:  ① → ⑩ (full pipeline)"]
      L2["📐 plan:  ① → ③ — two planners + Fable synthesis, no build"]
      L3["🔎 review:  ⑥ → ⑧ — two Codex lanes + Fable synthesis, read-only"]
      L4["🤖 passthrough:  /plx:codex · /plx:grok — one engine, no pipeline"]
    end

    classDef start fill:#0d3b66,stroke:#9ecbff,stroke-width:2px,color:#ffffff
    classDef step fill:#13334d,stroke:#5fb0ff,stroke-width:1.5px,color:#eaf2ff
    classDef decision fill:#7a5a00,stroke:#ffd166,stroke-width:2px,color:#fff8e1
    classDef write fill:#0b4d2c,stroke:#5ce39b,stroke-width:2px,color:#eafff3
    classDef review fill:#3a2d5c,stroke:#c2a8ff,stroke-width:2px,color:#f3edff
    classDef synth fill:#4a3500,stroke:#ffcf66,stroke-width:2px,color:#fff6df
    classDef cfg fill:#14463f,stroke:#5fe0c8,stroke-width:1.5px,color:#e8fff9
    classDef legend fill:#11161d,stroke:#6b7785,stroke-width:1px,color:#cdd6e0

    class U,REP start
    class SKL,IN,V,DOC step
    class RT decision
    class S4,S9 write
    class S7 review
    class S3,S8 synth
    class CFG cfg
    class DEV,PL,RV,S1,S2,S5,S6 step
    class L1,L2,L3,L4 legend
