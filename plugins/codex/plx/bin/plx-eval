#!/usr/bin/env bash
# Record local Parallax skill runs and engine lanes in one SQLite database.
#
# Usage examples:
#   plx-eval lane --repo /abs/repo --run-dir /tmp/plx-dev.A1b2C3 \
#     --engine grok --model grok-4.6 --effort medium --mode rw --role worker \
#     --started-at 2026-08-02T00:00:00.000Z --started-ns 1 --exit-code 0 \
#     --prompt-file /tmp/prompt.md --out /tmp/out.md --log /tmp/engine.log
#   plx-eval finish --skill dev --host codex --repo /abs/repo \
#     --run-dir /tmp/plx-dev.A1b2C3 --outcome pass --verification pass
#   plx-eval doctor
set -euo pipefail

# --------------------------------------------------------------------------- #
# Usage
# --------------------------------------------------------------------------- #

usage() {
  cat <<'EOF'
plx-eval — optional local SQLite trace capture for Parallax runs

Usage:
  plx-eval lane --repo <abs> --run-dir <abs> --engine <e> --model <m> \
    --effort <e> --mode <ro|rw> --role <r> --started-at <iso> \
    --started-ns <integer> --exit-code <integer> --prompt-file <abs> \
    [--rubric <name>] [--out <abs>] [--log <abs>]
  plx-eval finish --skill <name> --host <claude|codex|grok|unknown> \
    --repo <abs> [--run-dir <abs>] --outcome <pass|fail|partial|aborted> \
    --verification <pass|fail|not-run> [--host-model <value>] \
    [--task-file <abs>] [--shape-file <abs>] [--report-file <abs>]
  plx-eval doctor

What it does:
  Recording is enabled only when PLX_TRACE_DB names an absolute database path.
  When unset, commands succeed without writing. Lane records contain the complete
  effective prompt, engine log, and final output. Finish closes or creates the
  containing skill run. The database uses the locked schema at user_version 1.

Environment:
  PLX_TRACE_DB           absolute SQLite database path; explicit value wins
  XDG_CONFIG_HOME        optional config base (default: ~/.config)

Local config:
  ~/.config/parallax/env may contain one literal PLX_TRACE_DB=<absolute-path>
  assignment. The file is parsed and never shell-sourced.

Exit codes:
  0  success, including disabled no-op
  1  configured recording failed or schema is invalid
  2  usage error
EOF
}

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }
is_abs() { case "$1" in /*) return 0 ;; *) return 1 ;; esac; }
require_abs() {
  local name="$1" value="$2"
  [[ -n "$value" ]] || { echo "--$name required" >&2; exit 2; }
  is_abs "$value" || { echo "--$name must be an absolute path: $value" >&2; exit 2; }
}

# --------------------------------------------------------------------------- #
# Configuration
# --------------------------------------------------------------------------- #

load_trace_db() {
  local config_home config_file line value=""
  [[ -z "${PLX_TRACE_DB:-}" ]] || return 0

  if [[ -n "${XDG_CONFIG_HOME:-}" ]]; then
    config_home="$XDG_CONFIG_HOME"
  elif [[ -n "${HOME:-}" ]]; then
    config_home="$HOME/.config"
  else
    return 0
  fi
  config_file="$config_home/parallax/env"
  [[ -r "$config_file" ]] || return 0

  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    case "$line" in
      PLX_TRACE_DB=*) value="${line#PLX_TRACE_DB=}"; break ;;
    esac
  done < "$config_file"

  [[ -n "$value" ]] || return 0
  export PLX_TRACE_DB="$value"
}

load_trace_db

# --------------------------------------------------------------------------- #
# Command and flags
# --------------------------------------------------------------------------- #

CMD="${1:-}"
case "$CMD" in
  ""|--help|-h) usage; [[ -n "$CMD" ]] && exit 0 || exit 2 ;;
  lane|finish|doctor) shift ;;
  *) echo "unknown command: $CMD (see --help)" >&2; exit 2 ;;
esac

REPO=""
RUN_DIR=""
SKILL=""
HOST=""
HOST_MODEL=""
ENGINE=""
MODEL=""
EFFORT=""
MODE=""
ROLE=""
RUBRIC=""
STARTED_AT=""
STARTED_NS=""
EXIT_CODE=""
PROMPT_FILE=""
OUT=""
LOG=""
OUTCOME=""
VERIFICATION=""
TASK_FILE=""
SHAPE_FILE=""
REPORT_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --run-dir) need_value "$1" "${2:-}"; RUN_DIR="$2"; shift 2 ;;
    --skill) need_value "$1" "${2:-}"; SKILL="$2"; shift 2 ;;
    --host) need_value "$1" "${2:-}"; HOST="$2"; shift 2 ;;
    --host-model) need_value "$1" "${2:-}"; HOST_MODEL="$2"; shift 2 ;;
    --engine) need_value "$1" "${2:-}"; ENGINE="$2"; shift 2 ;;
    --model) need_value "$1" "${2:-}"; MODEL="$2"; shift 2 ;;
    --effort) need_value "$1" "${2:-}"; EFFORT="$2"; shift 2 ;;
    --mode) need_value "$1" "${2:-}"; MODE="$2"; shift 2 ;;
    --role) need_value "$1" "${2:-}"; ROLE="$2"; shift 2 ;;
    --rubric) need_value "$1" "${2:-}"; RUBRIC="$2"; shift 2 ;;
    --started-at) need_value "$1" "${2:-}"; STARTED_AT="$2"; shift 2 ;;
    --started-ns) need_value "$1" "${2:-}"; STARTED_NS="$2"; shift 2 ;;
    --exit-code) need_value "$1" "${2:-}"; EXIT_CODE="$2"; shift 2 ;;
    --prompt-file) need_value "$1" "${2:-}"; PROMPT_FILE="$2"; shift 2 ;;
    --out) need_value "$1" "${2:-}"; OUT="$2"; shift 2 ;;
    --log) need_value "$1" "${2:-}"; LOG="$2"; shift 2 ;;
    --outcome) need_value "$1" "${2:-}"; OUTCOME="$2"; shift 2 ;;
    --verification) need_value "$1" "${2:-}"; VERIFICATION="$2"; shift 2 ;;
    --task-file) need_value "$1" "${2:-}"; TASK_FILE="$2"; shift 2 ;;
    --shape-file) need_value "$1" "${2:-}"; SHAPE_FILE="$2"; shift 2 ;;
    --report-file) need_value "$1" "${2:-}"; REPORT_FILE="$2"; shift 2 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

if [[ "$CMD" == "doctor" ]]; then
  [[ -z "$REPO$RUN_DIR$SKILL$HOST$HOST_MODEL$ENGINE$MODEL$EFFORT$MODE$ROLE$RUBRIC$STARTED_AT$STARTED_NS$EXIT_CODE$PROMPT_FILE$OUT$LOG$OUTCOME$VERIFICATION$TASK_FILE$SHAPE_FILE$REPORT_FILE" ]] \
    || { echo "doctor takes no flags" >&2; exit 2; }
elif [[ "$CMD" == "lane" ]]; then
  require_abs repo "$REPO"
  require_abs run-dir "$RUN_DIR"
  require_abs prompt-file "$PROMPT_FILE"
  [[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
  [[ -d "$RUN_DIR" ]] || { echo "run directory not found: $RUN_DIR" >&2; exit 2; }
  [[ -f "$PROMPT_FILE" ]] || { echo "prompt file not found: $PROMPT_FILE" >&2; exit 2; }
  case "$ENGINE" in codex|grok|claude) ;; *) echo "--engine must be codex|grok|claude" >&2; exit 2 ;; esac
  case "$MODE" in ro|rw) ;; *) echo "--mode must be ro|rw" >&2; exit 2 ;; esac
  [[ -n "$MODEL" ]] || { echo "--model required" >&2; exit 2; }
  [[ -n "$EFFORT" ]] || { echo "--effort required" >&2; exit 2; }
  [[ -n "$ROLE" ]] || { echo "--role required" >&2; exit 2; }
  [[ -n "$STARTED_AT" ]] || { echo "--started-at required" >&2; exit 2; }
  [[ "$STARTED_NS" =~ ^[0-9]+$ ]] || { echo "--started-ns must be an integer" >&2; exit 2; }
  [[ "$EXIT_CODE" =~ ^-?[0-9]+$ ]] || { echo "--exit-code must be an integer" >&2; exit 2; }
  [[ -z "$OUT" ]] || require_abs out "$OUT"
  [[ -z "$LOG" ]] || require_abs log "$LOG"
else
  require_abs repo "$REPO"
  [[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
  [[ "$SKILL" =~ ^[a-z0-9][a-z0-9-]{0,63}$ ]] || {
    echo "--skill must be 1-64 lowercase letters, digits, or hyphens" >&2; exit 2;
  }
  case "$HOST" in claude|codex|grok|unknown) ;; *)
    echo "--host must be claude|codex|grok|unknown" >&2; exit 2 ;;
  esac
  case "$OUTCOME" in pass|fail|partial|aborted) ;; *)
    echo "--outcome must be pass|fail|partial|aborted" >&2; exit 2 ;;
  esac
  case "$VERIFICATION" in pass|fail|not-run) ;; *)
    echo "--verification must be pass|fail|not-run" >&2; exit 2 ;;
  esac
  if [[ -n "$RUN_DIR" ]]; then
    require_abs run-dir "$RUN_DIR"
    [[ -d "$RUN_DIR" ]] || { echo "run directory not found: $RUN_DIR" >&2; exit 2; }
  fi
  for optional in "$TASK_FILE" "$SHAPE_FILE" "$REPORT_FILE"; do
    if [[ -n "$optional" ]]; then
      is_abs "$optional" || { echo "optional files must use absolute paths: $optional" >&2; exit 2; }
      [[ -f "$optional" ]] || { echo "optional file not found: $optional" >&2; exit 2; }
    fi
  done
fi

# Disabled recording is a successful no-op after public argument validation.
if [[ -z "${PLX_TRACE_DB:-}" ]]; then
  if [[ "$CMD" == "doctor" ]]; then
    echo "plx-eval doctor: disabled (PLX_TRACE_DB unset)"
  fi
  exit 0
fi
is_abs "$PLX_TRACE_DB" || { echo "plx-eval: PLX_TRACE_DB must be absolute: $PLX_TRACE_DB" >&2; exit 2; }

# --------------------------------------------------------------------------- #
# SQLite backend
# --------------------------------------------------------------------------- #

export PLX_TRACE_CMD="$CMD"
export PLX_TRACE_DB_PATH="$PLX_TRACE_DB"
export PLX_TRACE_REPO="$REPO"
export PLX_TRACE_RUN_DIR="$RUN_DIR"
export PLX_TRACE_SKILL="$SKILL"
export PLX_TRACE_HOST="$HOST"
export PLX_TRACE_HOST_MODEL="$HOST_MODEL"
export PLX_TRACE_ENGINE="$ENGINE"
export PLX_TRACE_MODEL="$MODEL"
export PLX_TRACE_EFFORT="$EFFORT"
export PLX_TRACE_MODE="$MODE"
export PLX_TRACE_ROLE="$ROLE"
export PLX_TRACE_RUBRIC="$RUBRIC"
export PLX_TRACE_STARTED_AT="$STARTED_AT"
export PLX_TRACE_STARTED_NS="$STARTED_NS"
export PLX_TRACE_EXIT_CODE="$EXIT_CODE"
export PLX_TRACE_PROMPT_FILE="$PROMPT_FILE"
export PLX_TRACE_OUT="$OUT"
export PLX_TRACE_LOG="$LOG"
export PLX_TRACE_OUTCOME="$OUTCOME"
export PLX_TRACE_VERIFICATION="$VERIFICATION"
export PLX_TRACE_TASK_FILE="$TASK_FILE"
export PLX_TRACE_SHAPE_FILE="$SHAPE_FILE"
export PLX_TRACE_REPORT_FILE="$REPORT_FILE"

python3 <<'PY'
"""SQLite backend for the plx-eval Bash boundary.

Usage: invoked only by the surrounding plx-eval command after flag validation.
"""

# --------------------------------------------------------------------------- #
# Imports and constants
# --------------------------------------------------------------------------- #

import hashlib
import os
import re
import sqlite3
import sys
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path


SCHEMA_VERSION = 1
RUN_DIR_RE = re.compile(r"^plx-([a-z0-9][a-z0-9-]{0,63})\.([A-Za-z0-9]{6,})$")


# --------------------------------------------------------------------------- #
# Small helpers
# --------------------------------------------------------------------------- #

def env(name):
    return os.environ.get(name, "") or ""


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"


def generated_run_id(skill):
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    return f"{stamp}-{skill}-{uuid.uuid4().hex}"


def read_optional(path):
    if not path:
        return None
    try:
        return Path(path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None


def trace_digest(path):
    hasher = hashlib.sha256()
    if path and os.path.isfile(path):
        with open(path, "rb") as handle:
            for chunk in iter(lambda: handle.read(1024 * 1024), b""):
                hasher.update(chunk)
    return hasher.hexdigest()


def duration_ms(started_at, ended_at):
    try:
        start = datetime.fromisoformat(started_at.replace("Z", "+00:00"))
        end = datetime.fromisoformat(ended_at.replace("Z", "+00:00"))
        return max(0, int((end - start).total_seconds() * 1000))
    except (TypeError, ValueError):
        return None


def derive_grouped_run(run_dir):
    match = RUN_DIR_RE.fullmatch(os.path.basename(os.path.realpath(run_dir)))
    if not match:
        return None
    return match.group(0), match.group(1)


# --------------------------------------------------------------------------- #
# Schema and connection
# --------------------------------------------------------------------------- #

SCHEMA_STATEMENTS = (
    """CREATE TABLE runs (
    id TEXT PRIMARY KEY,
    skill TEXT NOT NULL,
    started_at TEXT NOT NULL,
    ended_at TEXT,
    host TEXT NOT NULL,
    host_model TEXT,
    task TEXT,
    routing_summary TEXT,
    outcome TEXT CHECK (outcome IS NULL OR outcome IN ('pass', 'fail', 'partial', 'aborted')),
    verification TEXT CHECK (verification IS NULL OR verification IN ('pass', 'fail', 'not-run')),
    final_report TEXT,
    host_trace TEXT
)""",
    """CREATE TABLE lanes (
    id TEXT PRIMARY KEY,
    run_id TEXT NOT NULL REFERENCES runs(id) ON DELETE CASCADE,
    role TEXT NOT NULL,
    engine TEXT NOT NULL,
    model TEXT NOT NULL,
    effort TEXT NOT NULL,
    mode TEXT NOT NULL CHECK (mode IN ('ro', 'rw')),
    routing_reason TEXT,
    candidates_json TEXT CHECK (candidates_json IS NULL OR json_valid(candidates_json)),
    started_at TEXT NOT NULL,
    ended_at TEXT,
    duration_ms INTEGER CHECK (duration_ms IS NULL OR duration_ms >= 0),
    exit_code INTEGER,
    prompt TEXT,
    trace TEXT,
    final_output TEXT,
    evaluation_json TEXT CHECK (evaluation_json IS NULL OR json_valid(evaluation_json)),
    trace_sha256 TEXT CHECK (trace_sha256 IS NULL OR length(trace_sha256) = 64)
)""",
    "CREATE INDEX lanes_run_id_idx ON lanes(run_id)",
)


def connect():
    database = Path(env("PLX_TRACE_DB_PATH"))
    parent = database.parent
    if not parent.is_dir():
        raise RuntimeError(f"database parent does not exist: {parent}")

    existed = database.exists()
    connection = sqlite3.connect(database, timeout=5.0)
    connection.execute("PRAGMA busy_timeout = 5000")
    connection.execute("PRAGMA foreign_keys = ON")
    deadline = time.monotonic() + 5.0
    while True:
        try:
            connection.execute("PRAGMA journal_mode = WAL")
            break
        except sqlite3.OperationalError as error:
            if "locked" not in str(error).lower() or time.monotonic() >= deadline:
                raise
            time.sleep(0.05)

    version = connection.execute("PRAGMA user_version").fetchone()[0]
    if version == 0:
        # Serialize first-use initialization so concurrent first lanes cannot
        # both attempt schema creation and lose one trace.
        connection.execute("BEGIN IMMEDIATE")
        try:
            version = connection.execute("PRAGMA user_version").fetchone()[0]
            table_count = connection.execute(
                "SELECT COUNT(*) FROM sqlite_schema "
                "WHERE type='table' AND name NOT LIKE 'sqlite_%'"
            ).fetchone()[0]
            if version == 0 and table_count == 0:
                for statement in SCHEMA_STATEMENTS:
                    connection.execute(statement)
                connection.execute(f"PRAGMA user_version = {SCHEMA_VERSION}")
                version = SCHEMA_VERSION
            elif version != SCHEMA_VERSION:
                raise RuntimeError(
                    f"unsupported schema user_version={version}; expected {SCHEMA_VERSION}"
                )
            connection.commit()
        except Exception:
            connection.rollback()
            connection.close()
            raise

    if version != SCHEMA_VERSION:
        connection.close()
        raise RuntimeError(
            f"unsupported schema user_version={version}; expected {SCHEMA_VERSION}"
        )

    tables = {
        row[0]
        for row in connection.execute(
            "SELECT name FROM sqlite_schema WHERE type='table' AND name NOT LIKE 'sqlite_%'"
        )
    }
    if tables != {"runs", "lanes"}:
        connection.close()
        raise RuntimeError(f"schema tables are invalid: {sorted(tables)}")

    if not existed:
        try:
            database.chmod(0o600)
        except OSError:
            pass
    return connection


def insert_run_if_missing(connection, run_id, skill, started_at):
    connection.execute(
        """
        INSERT INTO runs (id, skill, started_at, host)
        VALUES (?, ?, ?, 'unknown')
        ON CONFLICT(id) DO UPDATE SET
            started_at = MIN(runs.started_at, excluded.started_at)
        """,
        (run_id, skill, started_at),
    )


# --------------------------------------------------------------------------- #
# Commands
# --------------------------------------------------------------------------- #

def command_lane(connection):
    grouped = derive_grouped_run(env("PLX_TRACE_RUN_DIR"))
    standalone = grouped is None
    if grouped:
        run_id, skill = grouped
    else:
        skill = "standalone-lane"
        run_id = generated_run_id(skill)

    started_at = env("PLX_TRACE_STARTED_AT")
    ended_at = now_iso()
    started_ns = int(env("PLX_TRACE_STARTED_NS"))
    role = env("PLX_TRACE_ROLE")
    rubric = env("PLX_TRACE_RUBRIC")
    lane_id = f"{started_ns}-{role}-{os.getpid()}-{uuid.uuid4().hex}"
    log_path = env("PLX_TRACE_LOG")
    exit_code = int(env("PLX_TRACE_EXIT_CODE"))
    routing_reason = f"rubric:{rubric}" if rubric else f"role:{role}"

    with connection:
        insert_run_if_missing(connection, run_id, skill, started_at)
        connection.execute(
            """
            INSERT INTO lanes (
                id, run_id, role, engine, model, effort, mode, routing_reason,
                candidates_json, started_at, ended_at, duration_ms, exit_code,
                prompt, trace, final_output, evaluation_json, trace_sha256
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NULL, ?, ?, ?, ?, ?, ?, ?, NULL, ?)
            """,
            (
                lane_id,
                run_id,
                role,
                env("PLX_TRACE_ENGINE"),
                env("PLX_TRACE_MODEL"),
                env("PLX_TRACE_EFFORT"),
                env("PLX_TRACE_MODE"),
                routing_reason,
                started_at,
                ended_at,
                duration_ms(started_at, ended_at),
                exit_code,
                read_optional(env("PLX_TRACE_PROMPT_FILE")),
                read_optional(log_path),
                read_optional(env("PLX_TRACE_OUT")),
                trace_digest(log_path),
            ),
        )
        if standalone:
            connection.execute(
                """
                UPDATE runs
                SET ended_at = ?, outcome = ?, verification = 'not-run'
                WHERE id = ?
                """,
                (ended_at, "pass" if exit_code == 0 else "fail", run_id),
            )


def command_finish(connection):
    skill = env("PLX_TRACE_SKILL")
    run_dir = env("PLX_TRACE_RUN_DIR")
    grouped = derive_grouped_run(run_dir) if run_dir else None
    if run_dir and not grouped:
        raise RuntimeError(
            "--run-dir basename must match plx-<skill>.<six-or-more-alphanumerics>"
        )
    if grouped:
        run_id, derived_skill = grouped
        if derived_skill != skill:
            raise RuntimeError(
                f"run directory skill {derived_skill!r} does not match --skill {skill!r}"
            )
    else:
        run_id = generated_run_id(skill)

    ended_at = now_iso()
    with connection:
        insert_run_if_missing(connection, run_id, skill, ended_at)
        connection.execute(
            """
            UPDATE runs
            SET ended_at = ?, host = ?, host_model = ?, task = ?,
                routing_summary = ?, outcome = ?, verification = ?, final_report = ?
            WHERE id = ?
            """,
            (
                ended_at,
                env("PLX_TRACE_HOST"),
                env("PLX_TRACE_HOST_MODEL") or None,
                read_optional(env("PLX_TRACE_TASK_FILE")),
                read_optional(env("PLX_TRACE_SHAPE_FILE")),
                env("PLX_TRACE_OUTCOME"),
                env("PLX_TRACE_VERIFICATION"),
                read_optional(env("PLX_TRACE_REPORT_FILE")),
                run_id,
            ),
        )


def command_doctor(connection):
    integrity = connection.execute("PRAGMA integrity_check").fetchone()[0]
    if integrity != "ok":
        raise RuntimeError(f"integrity_check failed: {integrity}")
    runs = connection.execute("SELECT COUNT(*) FROM runs").fetchone()[0]
    lanes = connection.execute("SELECT COUNT(*) FROM lanes").fetchone()[0]
    print(
        "plx-eval doctor: ok — "
        f"destination={env('PLX_TRACE_DB_PATH')} runs={runs} lanes={lanes}"
    )


# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

def main():
    connection = connect()
    try:
        command = env("PLX_TRACE_CMD")
        if command == "lane":
            command_lane(connection)
        elif command == "finish":
            command_finish(connection)
        elif command == "doctor":
            command_doctor(connection)
        else:
            raise RuntimeError(f"unsupported command: {command}")
    finally:
        connection.close()
    return 0


try:
    raise SystemExit(main())
except SystemExit:
    raise
except Exception as error:
    print(f"plx-eval: recording failed: {error}", file=sys.stderr)
    raise SystemExit(1)
PY
