#!/usr/bin/env bash
# Parallax engine API — the ONE wrapper that drives all engines headless.
# Usage:
#   plx-engine --engine codex|grok|claude --mode ro|rw --repo <abs-path> \
#     --prompt-file <file> --stdout
#   plx-engine --engine devin --mode full-access --repo <abs-path> \
#     --prompt-file <file> --stdout
#   plx-engine --print-rubric <name>
#
# Safety flags are pinned here per engine, not decided by callers:
#   codex  : gpt-5.6-sol, effort medium by default, --ignore-user-config,
#            approval_policy=never, --ephemeral, sandbox read-only |
#            workspace-write; the standalone Build writer may explicitly
#            request danger-full-access so it can write repository Git metadata
#            and launch its packaged review lanes
#   grok   : grok-4.6, effort always medium,
#            kernel sandbox read-only | workspace (Seatbelt/Landlock),
#            bypassPermissions (required for headless completion; the kernel
#            sandbox — not the permission mode — is the safety boundary)
#   claude : non-bare `claude -p` (bare mode breaks subscription auth),
#            safe mode + no session persistence + automatic customization
#            disabled, with source-tree guidance listed in the prompt;
#            ro = read-only tools, rw = sandboxed Bash without direct write
#            tools; the standalone Build writer may explicitly disable the
#            sandbox so it can create required local commits
#   devin  : SWE-2 High by default, non-interactive print mode, generated
#            config with automatic imports/updates/subagents disabled, and the
#            documented dangerous permission mode with no OS sandbox. Devin
#            therefore has full host access; repository-native Devin config can
#            still load. ATIF export supplies the validated final response.
# Full access is accepted for Devin, and for an rw worker- or build-worker-rubric
# Codex or Claude lane.
# Never use Codex's approvals-and-sandbox bypass or --yolo.

# --------------------------------------------------------------------------- #
# Main program
# --------------------------------------------------------------------------- #

main() {
set -euo pipefail

usage() {
  cat <<'EOF'
plx-engine — run a coding engine headless against a repo (Parallax engine API)

Usage:
  plx-engine --engine codex|grok|claude --mode ro|rw --repo <abs-path> \
    --prompt-file <file> [--rubric <name>] [--model <m>] [--effort <e>] --stdout
  plx-engine --engine devin --mode full-access --repo <abs-path> \
    --prompt-file <file> [--rubric <name>] [--model <m>] --stdout
  plx-engine ... --out <file> --log <file>     (instead of --stdout)
  plx-engine --print-rubric <name>             (print prompts/<name>.md and exit)

What it does:
  One non-interactive engine turn with transport settings pinned per engine
  (see the header of this script). For codex/grok/claude, mode `ro` = the engine
  cannot edit anything and `rw` = edits confined to --repo. Devin requires
  `full-access`; it is unrestricted transport, not an enforced read/write
  profile. With --rubric, the named rubric from the plugin's
  prompts/ dir is injected ahead of your prompt (codex/grok: prepended to the
  prompt; claude: appended to the system prompt). Your prompt file should open
  with the section header the rubric expects (see prompts/engines.md).
  Only the engine's FINAL message is emitted; progress/noise goes to the log.

Flags:
  --engine <e>          codex | grok | claude | devin (required)
  --mode <m>            ro | rw for codex/grok/claude; full-access for Devin
  --repo <dir>          absolute path to the target repo (required)
  --prompt-file <file>  file containing the brief/spec (required)
  --rubric <name>       lane rubric to inject (a file name under prompts/, no .md)
  --build-writer-full-access
                        allow one rw worker/build-worker-rubric Codex/Claude lane to write
                        Git metadata; invalid for ro, Grok, or other rubrics
  --model <m>           codex: default gpt-5.6-sol · claude: default opus ·
                        grok: default grok-4.6 · devin: default swe-2-high
  --effort <e>          codex: default medium · claude: default high ·
                        grok-4.6: always medium · other Grok models: default medium
                        Explicit values pass through except that grok-4.6 is pinned
                        to medium. Devin has no effort flag; a nonempty value is
                        rejected—choose a model variant instead.
  --stdout              print the final message to stdout; temp files auto-cleaned
  --out <f> --log <f>   instead of --stdout: write final message / full log to files
  --print-rubric <n>    print the named rubric (e.g. reviewer-correctness, engines)
  --help                this text

Caller notes:
  * Engine turns can be LONG (10-40+ min). Use a retained/background shell
    session with --out/--log rather than relying on a foreground timeout.
  * claude/grok: the host may require narrowly scoped approval for network/keychain
    access. The engine's own sandbox remains the confinement boundary.
  * grok only: TRUST THE EXIT CODE, not stderr — grok prints non-fatal
    `worker quit ... AuthorizationRequired` lines to stderr even on success.
  * rw mode: inspect what changed with `git -C <repo> status --short` / `diff`.
  * --build-writer-full-access removes filesystem confinement. It changes the
    transport permission only; the accepted spec and repository rules remain
    the writer's complete authority boundary.
  * Devin full-access mode likewise removes filesystem/network confinement and
    uses no OS sandbox. It does not grant publication or external-system authority.
    Repository-native Devin hooks, MCP servers, rules, and skills may still load.

Exit codes:
  0  success — stdout (or --out) holds the engine's final message
  1  engine or wrapper failure — details on stderr / in the log
  2  usage error — bad flags or missing/empty inputs
  3  not signed in — tell the user to log in (codex login / grok login / claude /login / devin auth login)
EOF
}

# Resolve symlinks so prompts/ is found when reached via a PATH symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$src")" && pwd)"
PROMPTS_DIR="$BIN_DIR/../prompts"

ENGINE=""
MODE=""
REPO=""
PROMPT=""
RUBRIC=""
MODEL=""
EFFORT=""
OUT=""
LOG=""
STDOUT=0
BUILD_WRITER_FULL_ACCESS=0
TMP_DIR=""
# SQLite trace capture (opt-in via PLX_TRACE_DB). Armed just before dispatch.
EVAL_ARMED=0
EVAL_RUN_DIR=""
EVAL_PROMPT_FILE=""
EVAL_STARTED_AT=""
EVAL_STARTED_NS=""
EVAL_ROLE=""
PLX_COMPLETED=0

# Exit handler: capture the execution code, reject an armed run that never
# completed output delivery, best-effort record the lane, then clean temp files.
# Recording failures never mask the execution result.
plx_engine_exit() {
  local rc=$?
  # Always restore errexit off for cleanup/recording so set -e cannot alter rc.
  set +e
  if [[ "$EVAL_ARMED" -eq 1 && "$rc" -eq 0 && "$PLX_COMPLETED" -ne 1 ]]; then
    echo "plx-engine: execution ended before output delivery completed" >&2
    rc=1
  fi
  if [[ "$EVAL_ARMED" -eq 1 && -n "$EVAL_RUN_DIR" ]]; then
    local out_arg=() log_arg=() rubric_arg=()
    # Hash stdout-mode artifacts before the temp dir is removed.
    if [[ -n "$OUT" && -e "$OUT" ]]; then out_arg=(--out "$OUT"); fi
    if [[ -n "$LOG" && -e "$LOG" ]]; then log_arg=(--log "$LOG"); fi
    if [[ -n "$RUBRIC" ]]; then rubric_arg=(--rubric "$RUBRIC"); fi
    if ! "$BIN_DIR/plx-eval" lane \
      --repo "$REPO" \
      --run-dir "$EVAL_RUN_DIR" \
      --engine "$ENGINE" \
      --model "$MODEL" \
      --effort "$EFFORT" \
      --mode "$MODE" \
      --role "$EVAL_ROLE" \
      --started-at "$EVAL_STARTED_AT" \
      --started-ns "$EVAL_STARTED_NS" \
      --exit-code "$rc" \
      --prompt-file "$EVAL_PROMPT_FILE" \
      ${rubric_arg[@]+"${rubric_arg[@]}"} \
      ${out_arg[@]+"${out_arg[@]}"} \
      ${log_arg[@]+"${log_arg[@]}"} 2>/dev/null; then
      echo "plx-engine: eval lane record failed (non-fatal)" >&2
    fi
  fi
  if [[ -n "$TMP_DIR" ]]; then "$BIN_DIR/plx-clean-temp" "$TMP_DIR"; fi
  exit "$rc"
}
trap plx_engine_exit EXIT

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --engine) need_value "$1" "${2:-}"; ENGINE="$2"; shift 2 ;;
    --mode) need_value "$1" "${2:-}"; MODE="$2"; shift 2 ;;
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --prompt-file) need_value "$1" "${2:-}"; PROMPT="$2"; shift 2 ;;
    --rubric) need_value "$1" "${2:-}"; RUBRIC="$2"; shift 2 ;;
    --model) need_value "$1" "${2:-}"; MODEL="$2"; shift 2 ;;
    --effort) need_value "$1" "${2:-}"; EFFORT="$2"; shift 2 ;;
    --out) need_value "$1" "${2:-}"; OUT="$2"; shift 2 ;;
    --log) need_value "$1" "${2:-}"; LOG="$2"; shift 2 ;;
    --stdout) STDOUT=1; shift ;;
    --build-writer-full-access) BUILD_WRITER_FULL_ACCESS=1; shift ;;
    --print-rubric)
      need_value "$1" "${2:-}"
      RF="$PROMPTS_DIR/$2.md"
      [[ -f "$RF" ]] || { echo "no such rubric: $2 (looked at $RF)" >&2; exit 2; }
      cat "$RF"; exit 0 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

case "$ENGINE" in codex|grok|claude|devin) ;; *) echo "--engine must be codex|grok|claude|devin" >&2; exit 2 ;; esac
case "$MODE" in ro|rw|full-access) ;; *) echo "--mode must be ro|rw|full-access" >&2; exit 2 ;; esac
if [[ "$ENGINE" == "devin" ]]; then
  [[ "$MODE" == "full-access" ]] || {
    echo "Devin requires --mode full-access; its transport is not read-only or workspace-confined" >&2
    exit 2
  }
  [[ -z "$EFFORT" ]] || {
    echo "Devin does not support --effort; choose an exact model variant such as swe-2-medium, swe-2-high, or swe-2-max" >&2
    exit 2
  }
elif [[ "$MODE" == "full-access" ]]; then
  echo "--mode full-access supports only Devin" >&2
  exit 2
fi
if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
  [[ "$MODE" == "rw" ]] || {
    echo "--build-writer-full-access requires --mode rw" >&2
    exit 2
  }
  [[ "$RUBRIC" == "worker" || "$RUBRIC" == "build-worker" ]] || {
    echo "--build-writer-full-access requires --rubric worker or build-worker" >&2
    exit 2
  }
  [[ "$ENGINE" == "codex" || "$ENGINE" == "claude" ]] || {
    echo "--build-writer-full-access supports only codex or claude" >&2
    exit 2
  }
fi
[[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
[[ -s "$PROMPT" ]] || { echo "prompt file missing/empty: $PROMPT" >&2; exit 2; }

# The claude engine runs inside a `cd $REPO` subshell — caller-relative paths
# must be absolutized before that. REPO is also absolutized so eval provenance
# always receives an absolute target path.
abspath() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s' "$PWD/$1" ;; esac; }
REPO="$(cd "$REPO" && pwd)"
PROMPT="$(abspath "$PROMPT")"
[[ -n "$OUT" ]] && OUT="$(abspath "$OUT")"
[[ -n "$LOG" ]] && LOG="$(abspath "$LOG")"

if [[ "$ENGINE" == "grok" ]]; then
  [[ -n "$MODEL" ]] || MODEL="grok-4.6"
  [[ -n "$EFFORT" ]] || EFFORT="medium"
elif [[ "$ENGINE" == "codex" ]]; then
  [[ -n "$MODEL" ]] || MODEL="gpt-5.6-sol"
  [[ -n "$EFFORT" ]] || EFFORT="medium"
elif [[ "$ENGINE" == "claude" ]]; then
  [[ -n "$MODEL" ]] || MODEL="opus"
  [[ -n "$EFFORT" ]] || EFFORT="high"
else
  [[ -n "$MODEL" ]] || MODEL="swe-2-high"
fi

# Grok 4.6 is tuned and validated only at medium reasoning in Parallax. Keep
# this invariant at the execution boundary so every pipeline and passthrough
# gets the same setting, including callers that request another effort.
[[ "$MODEL" == "grok-4.6" ]] && EFFORT="medium"

RUBRIC_FILE=""
if [[ -n "$RUBRIC" ]]; then
  RUBRIC_FILE="$PROMPTS_DIR/$RUBRIC.md"
  [[ -s "$RUBRIC_FILE" ]] || { echo "no such rubric: $RUBRIC (looked at $RUBRIC_FILE)" >&2; exit 2; }
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/plx-engine.XXXXXX")"
if [[ "$STDOUT" -eq 1 ]]; then
  OUT="$TMP_DIR/output.md"
  LOG="$TMP_DIR/engine.log"
else
  [[ -n "$OUT" ]] || { echo "--out required (or use --stdout)" >&2; exit 2; }
  [[ -n "$LOG" ]] || { echo "--log required (or use --stdout)" >&2; exit 2; }
fi
mkdir -p "$(dirname "$OUT")" "$(dirname "$LOG")"

# Derive run identity from the caller's original prompt directory. A directory
# named plx-<skill>.<suffix> groups lanes; every other direct call is standalone.
EVAL_ROLE="${RUBRIC:-adhoc}"
EVAL_RUN_DIR="$(cd -P "$(dirname "$PROMPT")" && pwd)"

# codex/grok take one prompt stream: rubric (if any) prepended to the brief.
# claude keeps them separate: rubric -> system prompt, brief -> user prompt.
EXEC_PROMPT="$PROMPT"
if [[ -n "$RUBRIC_FILE" && "$ENGINE" != "claude" ]]; then
  EXEC_PROMPT="$TMP_DIR/prompt.md"
  cat "$RUBRIC_FILE" > "$EXEC_PROMPT"
  printf '\n\n' >> "$EXEC_PROMPT"
  cat "$PROMPT" >> "$EXEC_PROMPT"
fi
EVAL_PROMPT_FILE="$EXEC_PROMPT"

run_codex() {
  local sandbox
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    sandbox="danger-full-access"
  elif [[ "$MODE" == "ro" ]]; then
    sandbox="read-only"
  else
    sandbox="workspace-write"
  fi
  if ! codex exec --ignore-user-config --sandbox "$sandbox" \
    -c approval_policy=never --skip-git-repo-check -C "$REPO" \
    -m "$MODEL" -c model_reasoning_effort="$EFFORT" --ephemeral \
    -o "$OUT" - < "$EXEC_PROMPT" > "$LOG" 2>&1; then
    if grep -qiE "not logged in|401 unauthorized|codex login|invalid api key" "$LOG"; then
      echo "plx-engine: codex not authenticated — run \`codex login\` (or set CODEX_API_KEY), then retry." >&2
      exit 3
    fi
    echo "codex invocation failed" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi
  [[ -s "$OUT" ]] || { echo "codex produced empty output: $OUT" >&2; exit 1; }
}

run_claude() {
  local -a flags guidance_paths
  local claude_prompt claude_settings path
  claude_prompt="$TMP_DIR/claude-prompt.md"
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    claude_settings='{"sandbox":{"enabled":false}}'
  else
    claude_settings='{"sandbox":{"enabled":true,"failIfUnavailable":true,"autoAllowBashIfSandboxed":true,"allowUnsandboxedCommands":false,"network":{"allowedDomains":[],"strictAllowlist":true}}}'
  fi
  flags=(
    --model "$MODEL"
    --effort "$EFFORT"
    --safe-mode
    --no-session-persistence
    --strict-mcp-config
    --mcp-config '{"mcpServers":{}}'
    --settings "$claude_settings"
  )
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    flags+=(--dangerously-skip-permissions --tools "Read,Grep,Glob,Bash" --allowedTools "Read,Grep,Glob,Bash")
  elif [[ "$MODE" == "ro" ]]; then
    flags+=(--permission-mode dontAsk --tools "Read,Grep,Glob" --allowedTools "Read,Grep,Glob")
  else
    flags+=(--permission-mode acceptEdits --tools "Read,Grep,Glob,Bash" --allowedTools "Read,Grep,Glob,Bash")
  fi
  [[ -n "$RUBRIC_FILE" ]] && flags+=(--append-system-prompt-file "$RUBRIC_FILE")

  cat "$EXEC_PROMPT" > "$claude_prompt"
  printf '\n\n## Parallax runtime boundary\n' >> "$claude_prompt"
  printf '%s\n' \
    'Safe mode disables automatic project customization. Before inspecting or changing a path, read the listed guidance that governs it. Root files apply repo-wide; nested files and .claude/rules apply only to their subtree or declared paths.' \
    >> "$claude_prompt"
  guidance_paths=()
  while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    guidance_paths+=("${path#"$REPO"/}")
  done < <(
    find "$REPO" \
      \( -path "$REPO/.git" -o -path '*/node_modules' -o -path '*/.venv' -o \
         -path '*/venv' -o -path '*/.cache' -o -path '*/__pycache__' -o \
         -path '*/.tox' -o -path '*/.nox' \) -prune -o \
      \( -name AGENTS.md -o -name CLAUDE.md -o -name CLAUDE.local.md -o \
         -path '*/.claude/rules/*.md' \) -print 2>/dev/null |
      LC_ALL=C sort -u
  )
  if [[ "${#guidance_paths[@]}" -eq 0 ]]; then
    printf '%s\n' '- No repository guidance files found.' >> "$claude_prompt"
  else
    for path in "${guidance_paths[@]}"; do
      printf -- '- %s\n' "$path" >> "$claude_prompt"
    done
  fi
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    printf '%s\n' \
      'Full host access is enabled only so this standalone Build worker can write repository Git metadata and launch its packaged review lanes. It does not expand task authority: work only inside this repository, follow the accepted spec and repository guidance, and do not publish or mutate external systems unless the spec explicitly authorizes the exact action and target. Direct Edit and Write tools are unavailable.' \
      >> "$claude_prompt"
  elif [[ "$MODE" == "rw" ]]; then
    printf '%s\n' \
      'For mutations, use sandboxed Bash commands confined to the repository. Direct Edit and Write tools are unavailable.' \
      >> "$claude_prompt"
  fi

  # Claude receives the rubric as a system-prompt append. Persist one explicit
  # effective-prompt artifact so its trace has the same complete boundary as
  # Codex and Grok lanes.
  if [[ -n "$RUBRIC_FILE" ]]; then
    EVAL_PROMPT_FILE="$TMP_DIR/effective-prompt.md"
    {
      printf '%s\n' '## Parallax system rubric'
      cat "$RUBRIC_FILE"
      printf '\n\n%s\n' '## Parallax user prompt'
      cat "$claude_prompt"
    } > "$EVAL_PROMPT_FILE"
  else
    EVAL_PROMPT_FILE="$claude_prompt"
  fi

  if ! (cd "$REPO" && claude -p "${flags[@]}" < "$claude_prompt" > "$OUT" 2> "$LOG"); then
    if grep -qiE "not logged in|please run /login" "$OUT" "$LOG"; then
      echo "plx-engine: Claude credentials unavailable — if Claude works in a local terminal, retry this wrapper with narrowly scoped host approval; otherwise run \`claude /login\`." >&2
      exit 3
    fi
    echo "claude invocation failed" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi
  if grep -qiE "not logged in|please run /login" "$OUT"; then
    echo "plx-engine: Claude credentials unavailable — if Claude works in a local terminal, retry this wrapper with narrowly scoped host approval; otherwise run \`claude /login\`." >&2
    exit 3
  fi
  [[ -s "$OUT" ]] || { echo "claude produced empty output: $OUT" >&2; exit 1; }
}

run_devin() {
  local -a guidance_paths
  local config export_file raw auth_log parser_log devin_prompt path auth_rc rc

  # Never preserve a prior successful answer when any validation or invocation
  # step fails, including missing binary and authentication checks.
  : > "$OUT"
  : > "$LOG"
  command -v devin >/dev/null 2>&1 || {
    echo "plx-engine: Devin CLI not found — install it and run \`devin auth login\`, then retry." >&2
    exit 1
  }

  config="$TMP_DIR/devin-config.json"
  export_file="$TMP_DIR/devin-export.json"
  raw="$TMP_DIR/devin-stdout.log"
  auth_log="$TMP_DIR/devin-auth.log"
  parser_log="$TMP_DIR/devin-parser.log"
  devin_prompt="$TMP_DIR/devin-prompt.md"
  cat > "$config" <<'JSON'
{
  "permissions": {"allow": [], "deny": [], "ask": []},
  "read_config_from": {"cursor": false, "windsurf": false, "claude": false},
  "subagents_enabled": false,
  "auto_update": false,
  "attribution": false,
  "show_hints": false,
  "notify": "never",
  "theme_mode": "nocolor"
}
JSON

  cat "$EXEC_PROMPT" > "$devin_prompt"
  printf '\n\n## Parallax runtime boundary\n' >> "$devin_prompt"
  printf '%s\n' \
    'Devin has full host access. Before inspecting or changing a path, read the listed guidance that governs it. Root files apply repo-wide; nested files and rule files apply only to their subtree or declared paths. Full access does not expand the task; publication, deployment, credential changes, and external-system mutations require the user to authorize the exact action and target.' \
    >> "$devin_prompt"
  guidance_paths=()
  while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    guidance_paths+=("${path#"$REPO"/}")
  done < <(
    find "$REPO" \
      \( -path "$REPO/.git" -o -path '*/node_modules' -o -path '*/.venv' -o \
         -path '*/venv' -o -path '*/.cache' -o -path '*/__pycache__' -o \
         -path '*/.tox' -o -path '*/.nox' \) -prune -o \
      \( -name AGENTS.md -o -name CLAUDE.md -o -name CLAUDE.local.md -o \
         -path '*/.claude/rules/*.md' -o -path '*/.devin/rules/*.md' -o \
         -path '*/.devin/skills/*/SKILL.md' \) -print 2>/dev/null |
      LC_ALL=C sort -u
  )
  if [[ "${#guidance_paths[@]}" -eq 0 ]]; then
    printf '%s\n' '- No repository guidance files found.' >> "$devin_prompt"
  else
    for path in "${guidance_paths[@]}"; do
      printf -- '- %s\n' "$path" >> "$devin_prompt"
    done
  fi
  EVAL_PROMPT_FILE="$devin_prompt"

  set +e
  env -u DEVIN_SANDBOX devin --config "$config" auth status > "$auth_log" 2>&1
  auth_rc=$?
  set -e
  if [[ $auth_rc -ne 0 ]]; then
    if grep -qiE 'not logged in|please log in|authentication required|no credentials|devin auth login' "$auth_log"; then
      echo "plx-engine: Devin not authenticated — run \`devin auth login\`, then retry." >&2
      exit 3
    fi
    echo "plx-engine: \`devin auth status\` failed (exit $auth_rc)" >&2
    exit 1
  fi

  devin_interrupt() {
    local tries=0 devin_state=""
    trap - INT TERM
    set +e
    [[ -n "${DEVIN_PID:-}" ]] && kill -TERM -- "-$DEVIN_PID" 2>/dev/null
    [[ -n "${DEVIN_PID:-}" ]] && kill -TERM "$DEVIN_PID" 2>/dev/null
    devin_state="$(ps -o stat= -p "${DEVIN_PID:-0}" 2>/dev/null || true)"
    while [[ -n "$devin_state" && "$devin_state" != Z* && "$tries" -lt 40 ]]; do
      sleep 0.05
      tries=$((tries + 1))
      devin_state="$(ps -o stat= -p "${DEVIN_PID:-0}" 2>/dev/null || true)"
    done
    [[ -n "${DEVIN_PID:-}" ]] && kill -KILL -- "-$DEVIN_PID" 2>/dev/null
    [[ -n "${DEVIN_PID:-}" ]] && kill -KILL "$DEVIN_PID" 2>/dev/null
    tries=0
    devin_state="$(ps -o stat= -p "${DEVIN_PID:-0}" 2>/dev/null || true)"
    while [[ -n "$devin_state" && "$devin_state" != Z* && "$tries" -lt 40 ]]; do
      sleep 0.05
      tries=$((tries + 1))
      devin_state="$(ps -o stat= -p "${DEVIN_PID:-0}" 2>/dev/null || true)"
    done
    if [[ -n "$devin_state" && "$devin_state" != Z* ]]; then
      echo "plx-engine: Devin invocation interrupted; could not confirm that the owned process tree stopped" >&2
    else
      [[ -n "${DEVIN_PID:-}" ]] && wait "$DEVIN_PID" 2>/dev/null
      echo "plx-engine: Devin invocation interrupted; the owned process tree was stopped and will not be retried" >&2
    fi
    exit 1
  }

  set +e
  DEVIN_PID=""
  trap devin_interrupt INT TERM
  (
    cd "$REPO" || exit 1
    exec python3 -c \
      'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
      env -u DEVIN_SANDBOX devin --config "$config" \
      --permission-mode dangerous --model "$MODEL" \
      --prompt-file "$devin_prompt" --export "$export_file" -p </dev/null
  ) > "$raw" 2> "$LOG" &
  DEVIN_PID=$!
  wait "$DEVIN_PID"
  rc=$?
  DEVIN_PID=""
  trap - INT TERM
  set -e

  if [[ -s "$raw" ]]; then
    printf '\n%s\n' '--- Devin print stdout ---' >> "$LOG"
    cat "$raw" >> "$LOG"
  fi
  if [[ $rc -ne 0 ]]; then
    if grep -qiE 'not logged in|please log in|authentication required|no credentials|devin auth login' "$LOG" "$raw"; then
      echo "plx-engine: Devin not authenticated — run \`devin auth login\`, then retry." >&2
      exit 3
    fi
    echo "Devin invocation failed (exit $rc)" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi

  if ! python3 - "$export_file" "$OUT" > "$parser_log" 2>&1 <<'PY_ATIF'
import json
import sys
from pathlib import Path

export_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])

try:
    document = json.loads(export_path.read_text())
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"missing or malformed Devin ATIF export: {exc}")

if document.get("schema_version") != "ATIF-v1.7":
    raise SystemExit(f"unsupported Devin ATIF schema: {document.get('schema_version')!r}")

steps = document.get("steps")
if not isinstance(steps, list) or not steps:
    raise SystemExit("Devin ATIF export has no steps")

terminal = steps[-1]
if not isinstance(terminal, dict) or terminal.get("source") != "agent":
    raise SystemExit("Devin ATIF export has no terminal agent response")
if terminal.get("tool_calls") not in (None, []):
    raise SystemExit("Devin ATIF export ended on a pending or denied tool call")

message = terminal.get("message")
if not isinstance(message, str) or not message.strip():
    raise SystemExit("Devin ATIF terminal response is empty")

output_path.write_text(message.rstrip() + "\n")
PY_ATIF
  then
    echo "plx-engine: Devin completed without a valid terminal response" >&2
    [[ -s "$parser_log" ]] && sed -n '1,20p' "$parser_log" >&2
    exit 1
  fi
}

run_grok() {
  local sandbox raw rc stop text pyrc final
  [[ "$MODE" == "ro" ]] && sandbox="read-only" || sandbox="workspace"
  raw="$TMP_DIR/raw.json"

  set +e
  grok --no-auto-update --cwd "$REPO" \
    --model "$MODEL" --effort "$EFFORT" \
    --permission-mode bypassPermissions --sandbox "$sandbox" \
    --no-plan --no-subagents --no-memory --no-alt-screen --output-format json \
    --prompt-file "$EXEC_PROMPT" > "$raw" 2> "$LOG"
  rc=$?
  set -e

  # Genuine "not signed in" prints the OAuth sign-in prompt to stderr. This is
  # the real login signal — NOT the AuthorizationRequired worker noise, which
  # also appears on success.
  if grep -qiE "Open this URL to sign in|Signing in with Grok" "$LOG"; then
    echo "plx-engine: grok not authenticated — run \`grok login\` (or export XAI_API_KEY), then retry." >&2
    exit 3
  fi

  if [[ $rc -ne 0 ]]; then
    if grep -qiE \
      '(seatbelt.*(fail|denied|operation not permitted)|(fail|denied|operation not permitted).*seatbelt|sandbox(_init| initialization| setup).*(fail|denied|operation not permitted)|(fail|denied|operation not permitted).*(sandbox_init|sandbox initialization|sandbox setup))' \
      "$LOG"; then
      echo "PLX_GROK_SANDBOX_UNAVAILABLE" >&2
      echo "Grok $sandbox sandbox could not initialize under the host sandbox." >&2
      echo "The Grok lane did not start. Do not perform or attribute the task to this lane." >&2
      [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
      exit 1
    fi
    echo "grok invocation failed (exit $rc)" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi

  set +e
  stop="$(python3 -c 'import json,sys
try:
    print(json.load(open(sys.argv[1])).get("stopReason") or "")
except Exception:
    print("")' "$raw")"
  text="$(python3 -c 'import json,sys
try:
    sys.stdout.write(json.load(open(sys.argv[1])).get("text") or "")
except Exception:
    sys.exit(7)' "$raw")"
  pyrc=$?
  set -e

  if [[ $pyrc -ne 0 ]]; then
    # JSON parse failed (unexpected grok output shape) — fall back to raw text.
    text="$(cat "$raw")"
  fi

  if [[ "$stop" == "cancelled" || "$stop" == "Cancelled" ]]; then
    echo "plx-engine: grok turn was cancelled — a tool call was gated, not auto-approved." >&2
    echo "plx-engine: expected only if bypassPermissions is not taking effect (check grok version)." >&2
    exit 1
  fi

  [[ -n "$text" ]] || { echo "plx-engine: grok empty output (stopReason=$stop)" >&2; exit 1; }

  # Older Grok builds aggregated every text chunk into the envelope, including
  # interleaved subagent output and pre-tool narration. The session store keeps
  # proper message records; retain that compatibility fallback even though current
  # Parallax runs disable subagents. (Verified grok 0.2.39, 2026-06-11:
  # tests/evals/2026-06-11_grok-output-aggregation-eval.md)
  final="$(python3 -c 'import json,os,sys,urllib.parse
try:
    sid = json.load(open(sys.argv[1])).get("sessionId") or ""
    if not sid:
        sys.exit(0)
    repo = os.path.realpath(sys.argv[2])
    path = os.path.join(os.path.expanduser("~/.grok/sessions"),
                        urllib.parse.quote(repo, safe=""), sid, "chat_history.jsonl")
    last = None
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            m = json.loads(line)
            if m.get("type") == "assistant":
                last = m
    c = (last or {}).get("content")
    if isinstance(c, str) and c.strip():
        sys.stdout.write(c)
except Exception:
    pass' "$raw" "$REPO")"
  [[ -n "$final" ]] && text="$final"

  printf '%s\n' "$text" > "$OUT"

  # Headless one-shot runs never resume; drop this run's session dir so
  # ~/.grok/sessions doesn't grow without bound (grok has no --ephemeral).
  # Failure paths exit above and keep the session for debugging.
  python3 -c 'import json,os,shutil,sys,urllib.parse
try:
    sid = json.load(open(sys.argv[1])).get("sessionId") or ""
    if not sid:
        sys.exit(0)
    repo = os.path.realpath(sys.argv[2])
    d = os.path.join(os.path.expanduser("~/.grok/sessions"),
                     urllib.parse.quote(repo, safe=""), sid)
    if os.path.isdir(d):
        shutil.rmtree(d)
        parent = os.path.dirname(d)
        if os.listdir(parent) in ([], ["prompt_history.jsonl"]):
            shutil.rmtree(parent)
except Exception:
    pass' "$raw" "$REPO" || true
}

# Arm only after the effective prompt exists. The exit trap records every engine
# completion, including authentication and invocation failures.
EVAL_STARTED_AT="$(date -u +"%Y-%m-%dT%H:%M:%S.000Z" 2>/dev/null || date -u +"%Y-%m-%dT%H:%M:%SZ")"
EVAL_STARTED_NS="$(python3 -c 'import time; print(time.time_ns())' 2>/dev/null \
  || python3 -c 'import time; print(int(time.time()*1e9))' 2>/dev/null \
  || echo "0")"
EVAL_ARMED=1

case "$ENGINE" in
  codex) run_codex ;;
  claude) run_claude ;;
  devin) run_devin ;;
  grok) run_grok ;;
esac

if [[ "$STDOUT" -eq 1 ]]; then
  cat "$OUT"
else
  echo "OK plx-engine engine=$ENGINE mode=$MODE out=$OUT log=$LOG"
fi
PLX_COMPLETED=1
}

# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

main "$@"
