#!/usr/bin/env bash
# Parallax engine API — the ONE wrapper that drives all engines headless.
# Usage:
#   plx-engine --engine codex|grok|claude|gemini --mode ro|rw --repo <abs-path> \
#     --prompt-file <file> --stdout
#   plx-engine --engine devin --mode full-access --repo <abs-path> \
#     --prompt-file <file> --stdout
#   plx-engine --print-rubric <name>
#
# Per-engine safety flags are pinned in the run_<engine> functions below, not
# chosen by callers. Never use Codex's approvals-and-sandbox bypass or --yolo.

# --------------------------------------------------------------------------- #
# Main program
# --------------------------------------------------------------------------- #

main() {
set -euo pipefail

usage() {
  cat <<'EOF'
plx-engine — run a coding engine headless against a repo (Parallax engine API)

Usage:
  plx-engine --engine codex|grok|claude|gemini --mode ro|rw --repo <abs-path> \
    --prompt-file <file> [--rubric <name>] [--model <m>] [--effort <e>] --stdout
  plx-engine --engine devin --mode full-access --repo <abs-path> \
    --prompt-file <file> [--rubric <name>] [--model <m>] --stdout
  plx-engine ... --out <file> --log <file>     (instead of --stdout)
  plx-engine --print-rubric <name>             (print prompts/<name>.md and exit)

What it does:
  One non-interactive engine turn. Mode `ro` cannot edit; `rw` confines edits to
  --repo unless an explicit full-access flag is given. Devin requires `full-access`.
  --rubric injects prompts/<name>.md ahead of the prompt file, which should open
  with the header the rubric expects. Only the engine's final message is emitted.

Flags:
  --engine <e>          codex | grok | claude | devin | gemini (required)
  --mode <m>            ro | rw for codex/grok/claude/gemini; full-access for Devin
  --repo <dir>          absolute path to the target repo (required)
  --prompt-file <file>  file containing the brief/spec (required)
  --rubric <name>       lane rubric to inject (a file name under prompts/, no .md)
  --build-writer-full-access
                        allow one rw build-worker-rubric Codex/Claude lane to write
                        Git metadata; invalid for ro, Grok, or other rubrics
  --claude-passthrough-full-access
                        give one rubric-free rw Claude passthrough full host access
  --codex-passthrough-full-access
                        give one rubric-free rw Codex passthrough full host access
  --model <m>           codex: default gpt-6.1-sol · claude: default claude-opus-5-5 ·
                        grok: default grok-4.6 · devin: default swe-2-high · gemini: auto
  --effort <e>          codex: default medium · claude: default high ·
                        grok-4.6: always medium · other Grok models: default medium
                        Gemini and Devin reject --effort; choose a model instead.
  --stdout              print the final message to stdout; temp files auto-cleaned
  --out <f> --log <f>   instead of --stdout: write final message / full log to files
  --print-rubric <n>    print the named rubric (e.g. reviewer-correctness)
  --help                this text

Caller notes:
  * Engine turns can run 10-40+ min; prefer a background shell with --out/--log.
  * Grok prints non-fatal AuthorizationRequired lines to stderr; trust the exit code.
  * Full-access flags change transport permission only, never task authority.

Exit codes:
  0  success — stdout (or --out) holds the engine's final message
  1  engine or wrapper failure — details on stderr / in the log
  2  usage error — bad flags or missing/empty inputs
  3  not signed in — tell the user to log in (codex login / grok login / claude /login / devin auth login)
  4  Devin explicitly retryable internal protocol failure — reconcile partial work before retry
EOF
}

# Resolve symlinks so prompts/ is found when reached via a PATH symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$src")" && pwd)"
PROMPTS_DIR="$BIN_DIR/../prompts"

ENGINE=""
MODE=""
REPO=""
PROMPT=""
RUBRIC=""
MODEL=""
EFFORT=""
OUT=""
LOG=""
STDOUT=0
BUILD_WRITER_FULL_ACCESS=0
CLAUDE_PASSTHROUGH_FULL_ACCESS=0
CODEX_PASSTHROUGH_FULL_ACCESS=0
TMP_DIR=""

plx_engine_exit() {
  local rc=$?
  if [[ -n "$TMP_DIR" ]]; then "$BIN_DIR/plx-clean-temp" "$TMP_DIR" || true; fi
  exit "$rc"
}
trap plx_engine_exit EXIT

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --engine) need_value "$1" "${2:-}"; ENGINE="$2"; shift 2 ;;
    --mode) need_value "$1" "${2:-}"; MODE="$2"; shift 2 ;;
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --prompt-file) need_value "$1" "${2:-}"; PROMPT="$2"; shift 2 ;;
    --rubric) need_value "$1" "${2:-}"; RUBRIC="$2"; shift 2 ;;
    --model) need_value "$1" "${2:-}"; MODEL="$2"; shift 2 ;;
    --effort) need_value "$1" "${2:-}"; EFFORT="$2"; shift 2 ;;
    --out) need_value "$1" "${2:-}"; OUT="$2"; shift 2 ;;
    --log) need_value "$1" "${2:-}"; LOG="$2"; shift 2 ;;
    --stdout) STDOUT=1; shift ;;
    --build-writer-full-access) BUILD_WRITER_FULL_ACCESS=1; shift ;;
    --claude-passthrough-full-access) CLAUDE_PASSTHROUGH_FULL_ACCESS=1; shift ;;
    --codex-passthrough-full-access) CODEX_PASSTHROUGH_FULL_ACCESS=1; shift ;;
    --print-rubric)
      need_value "$1" "${2:-}"
      RF="$PROMPTS_DIR/$2.md"
      [[ -f "$RF" ]] || { echo "no such rubric: $2 (looked at $RF)" >&2; exit 2; }
      cat "$RF"; exit 0 ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

case "$ENGINE" in codex|grok|claude|devin|gemini) ;; *) echo "--engine must be codex|grok|claude|devin|gemini" >&2; exit 2 ;; esac
case "$MODE" in ro|rw|full-access) ;; *) echo "--mode must be ro|rw|full-access" >&2; exit 2 ;; esac
if [[ "$ENGINE" == "devin" ]]; then
  [[ "$MODE" == "full-access" ]] || {
    echo "Devin requires --mode full-access; its transport is not read-only or workspace-confined" >&2
    exit 2
  }
  [[ -z "$EFFORT" ]] || {
    echo "Devin does not support --effort; choose an exact model variant such as swe-2-medium, swe-2-high, or swe-2-max" >&2
    exit 2
  }
elif [[ "$ENGINE" == "gemini" && -n "$EFFORT" ]]; then
  echo "Gemini does not support --effort; use --model instead" >&2
  exit 2
elif [[ "$MODE" == "full-access" ]]; then
  echo "--mode full-access supports only Devin" >&2
  exit 2
fi
if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
  [[ "$MODE" == "rw" ]] || {
    echo "--build-writer-full-access requires --mode rw" >&2
    exit 2
  }
  [[ "$RUBRIC" == "build-worker" ]] || {
    echo "--build-writer-full-access requires --rubric build-worker" >&2
    exit 2
  }
  [[ "$ENGINE" == "codex" || "$ENGINE" == "claude" ]] || {
    echo "--build-writer-full-access supports only codex or claude" >&2
    exit 2
  }
fi
if [[ "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
  [[ "$ENGINE" == "claude" && "$MODE" == "rw" && -z "$RUBRIC" && "$BUILD_WRITER_FULL_ACCESS" -eq 0 ]] || {
    echo "--claude-passthrough-full-access requires rubric-free Claude --mode rw" >&2
    exit 2
  }
fi
if [[ "$CODEX_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
  [[ "$ENGINE" == "codex" && "$MODE" == "rw" && -z "$RUBRIC" && "$BUILD_WRITER_FULL_ACCESS" -eq 0 ]] || {
    echo "--codex-passthrough-full-access requires rubric-free Codex --mode rw" >&2
    exit 2
  }
fi
[[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
[[ -s "$PROMPT" ]] || { echo "prompt file missing/empty: $PROMPT" >&2; exit 2; }

# The claude engine runs inside a `cd $REPO` subshell — caller-relative paths
# must be absolutized before that.
abspath() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s' "$PWD/$1" ;; esac; }
REPO="$(cd "$REPO" && pwd)"
PROMPT="$(abspath "$PROMPT")"
[[ -n "$OUT" ]] && OUT="$(abspath "$OUT")"
[[ -n "$LOG" ]] && LOG="$(abspath "$LOG")"

if [[ "$ENGINE" == "grok" ]]; then
  [[ -n "$MODEL" ]] || MODEL="grok-4.6"
  [[ -n "$EFFORT" ]] || EFFORT="medium"
elif [[ "$ENGINE" == "codex" ]]; then
  [[ -n "$MODEL" ]] || MODEL="gpt-6.1-sol"
  [[ -n "$EFFORT" ]] || EFFORT="medium"
elif [[ "$ENGINE" == "claude" ]]; then
  [[ -n "$MODEL" ]] || MODEL="claude-opus-5-5"
  [[ -n "$EFFORT" ]] || EFFORT="high"
elif [[ "$ENGINE" == "gemini" ]]; then
  [[ -n "$MODEL" ]] || MODEL="auto"
else
  [[ -n "$MODEL" ]] || MODEL="swe-2-high"
fi

# Grok 4.6 is tuned and validated only at medium reasoning in Parallax. Keep
# this invariant at the execution boundary so every pipeline and passthrough
# gets the same setting, including callers that request another effort.
[[ "$MODEL" == "grok-4.6" ]] && EFFORT="medium"

RUBRIC_FILE=""
if [[ -n "$RUBRIC" ]]; then
  RUBRIC_FILE="$PROMPTS_DIR/$RUBRIC.md"
  [[ -s "$RUBRIC_FILE" ]] || { echo "no such rubric: $RUBRIC (looked at $RUBRIC_FILE)" >&2; exit 2; }
fi

TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/plx-engine.XXXXXX")"
if [[ "$STDOUT" -eq 1 ]]; then
  OUT="$TMP_DIR/output.md"
  LOG="$TMP_DIR/engine.log"
else
  [[ -n "$OUT" ]] || { echo "--out required (or use --stdout)" >&2; exit 2; }
  [[ -n "$LOG" ]] || { echo "--log required (or use --stdout)" >&2; exit 2; }
fi
mkdir -p "$(dirname "$OUT")" "$(dirname "$LOG")"

# codex/grok take one prompt stream: rubric (if any) prepended to the brief.
# claude keeps them separate: rubric -> system prompt, brief -> user prompt.
EXEC_PROMPT="$PROMPT"
if [[ -n "$RUBRIC_FILE" && "$ENGINE" != "claude" ]]; then
  EXEC_PROMPT="$TMP_DIR/prompt.md"
  cat "$RUBRIC_FILE" > "$EXEC_PROMPT"
  printf '\n\n' >> "$EXEC_PROMPT"
  cat "$PROMPT" >> "$EXEC_PROMPT"
fi

run_codex() {
  local sandbox
  local -a flags
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 || "$CODEX_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
    sandbox="danger-full-access"
  elif [[ "$MODE" == "ro" ]]; then
    sandbox="read-only"
  else
    sandbox="workspace-write"
  fi
  flags=(--sandbox "$sandbox" -c approval_policy=never --skip-git-repo-check
    -C "$REPO" -m "$MODEL" -c model_reasoning_effort="$EFFORT" --ephemeral
    -o "$OUT" -)
  if [[ "$CODEX_PASSTHROUGH_FULL_ACCESS" -eq 0 ]]; then
    flags=(--ignore-user-config "${flags[@]}")
  fi
  if ! codex exec "${flags[@]}" < "$EXEC_PROMPT" > "$LOG" 2>&1; then
    if grep -qiE "not logged in|401 unauthorized|codex login|invalid api key" "$LOG"; then
      echo "plx-engine: codex not authenticated — run \`codex login\` (or set CODEX_API_KEY), then retry." >&2
      exit 3
    fi
    echo "codex invocation failed" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi
  [[ -s "$OUT" ]] || { echo "codex produced empty output: $OUT" >&2; exit 1; }
}

# Safe-mode Claude and Devin do not discover repo guidance, so list it in the
# prompt. Extra arguments add -path patterns.
list_guidance() {
  local -a extra=() found=()
  local pat path
  for pat in "$@"; do extra+=(-o -path "$pat"); done
  while IFS= read -r path; do
    [[ -f "$path" ]] && found+=("${path#"$REPO"/}")
  done < <(
    find "$REPO" \
      \( -path "$REPO/.git" -o -path '*/node_modules' -o -path '*/.venv' -o \
         -path '*/venv' -o -path '*/.cache' -o -path '*/__pycache__' -o \
         -path '*/.tox' -o -path '*/.nox' \) -prune -o \
      \( -name AGENTS.md -o -name CLAUDE.md -o -name CLAUDE.local.md -o \
         -path '*/.claude/rules/*.md' ${extra[@]+"${extra[@]}"} \) -print 2>/dev/null |
      LC_ALL=C sort -u
  )
  if [[ "${#found[@]}" -eq 0 ]]; then
    printf '%s\n' '- No repository guidance files found.'
  else
    printf -- '- %s\n' "${found[@]}"
  fi
}

run_claude() {
  local -a flags
  local claude_prompt claude_settings claude_fs="" repo_json claude_rc=0
  claude_prompt="$TMP_DIR/claude-prompt.md"
  if [[ "$MODE" == "ro" ]]; then
    # ro Bash may inspect but never write the checkout; the OS sandbox enforces it.
    repo_json="${REPO//\\/\\\\}"
    repo_json="${repo_json//\"/\\\"}"
    claude_fs=",\"filesystem\":{\"denyWrite\":[\"$repo_json\"]}"
  fi
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 || "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
    claude_settings='{"sandbox":{"enabled":false}}'
  else
    claude_settings='{"sandbox":{"enabled":true,"failIfUnavailable":true,"autoAllowBashIfSandboxed":true,"allowUnsandboxedCommands":false,"network":{"allowedDomains":[],"strictAllowlist":true}'"$claude_fs"'}}'
  fi
  flags=(
    --model "$MODEL"
    --effort "$EFFORT"
    --no-session-persistence
    --settings "$claude_settings"
  )
  if [[ "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
    flags+=(--dangerously-skip-permissions)
  else
    flags+=(--safe-mode --strict-mcp-config --mcp-config '{"mcpServers":{}}')
  fi
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    flags+=(--dangerously-skip-permissions --tools "Read,Grep,Glob,Bash" --allowedTools "Read,Grep,Glob,Bash")
  elif [[ "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 0 ]]; then
    if [[ "$MODE" == "ro" ]]; then
      flags+=(--permission-mode dontAsk --tools "Read,Grep,Glob,Bash" --allowedTools "Read,Grep,Glob,Bash")
    else
      flags+=(--permission-mode acceptEdits --tools "Read,Grep,Glob,Bash" --allowedTools "Read,Grep,Glob,Bash")
    fi
  fi
  [[ -n "$RUBRIC_FILE" ]] && flags+=(--append-system-prompt-file "$RUBRIC_FILE")

  cat "$EXEC_PROMPT" > "$claude_prompt"
  printf '\n\n## Parallax runtime boundary\n' >> "$claude_prompt"
  if [[ "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 0 ]]; then
    printf '%s\n' \
      'Safe mode disables automatic project customization. Before inspecting or changing a path, read the listed guidance that governs it. Root files apply repo-wide; nested files and .claude/rules apply only to their subtree or declared paths.' \
      >> "$claude_prompt"
  fi
  list_guidance >> "$claude_prompt"
  if [[ "$BUILD_WRITER_FULL_ACCESS" -eq 1 ]]; then
    printf '%s\n' \
      'Full host access is enabled only so this standalone Build worker can write repository Git metadata and launch its packaged review lanes. It does not expand task authority: work only inside this repository, follow the accepted spec and repository guidance, and do not publish or mutate external systems unless the spec explicitly authorizes the exact action and target. Direct Edit and Write tools are unavailable.' \
      >> "$claude_prompt"
  elif [[ "$CLAUDE_PASSTHROUGH_FULL_ACCESS" -eq 1 ]]; then
    printf '%s\n' \
      'Full host access is available for this explicit Claude passthrough. Use it only as needed for the user request. Follow repository guidance. Do not publish or change remote systems unless the request authorizes the action and target.' \
      >> "$claude_prompt"
  elif [[ "$MODE" == "rw" ]]; then
    printf '%s\n' \
      'For mutations, use sandboxed Bash commands confined to the repository. Direct Edit and Write tools are unavailable.' \
      >> "$claude_prompt"
  else
    printf '%s\n' \
      'Read-only: use Bash only to inspect (git, diff, search, read-only scripts). The sandbox blocks writes to the repository; use $TMPDIR for scratch files.' \
      >> "$claude_prompt"
  fi

  (cd "$REPO" && claude -p "${flags[@]}" < "$claude_prompt" > "$OUT" 2> "$LOG") || claude_rc=$?
  # Claude Code can leave an empty write-staging directory in the checkout.
  if [[ ! -L "$REPO/.claude" ]] && rmdir "$REPO/.claude/.cc-writes" 2>/dev/null; then
    rmdir "$REPO/.claude" 2>/dev/null || true
  fi
  if grep -qiE "not logged in|please run /login" "$OUT" "$LOG"; then
    # Codex's macOS sandbox hides the keychain that holds Claude's login, so a
    # Claude lane launched from a sandboxed Codex host always looks logged out.
    if [[ -n "${CODEX_SANDBOX:-}" ]]; then
      echo "plx-engine: Claude login is unreachable from inside the Codex sandbox (CODEX_SANDBOX=$CODEX_SANDBOX), not missing — rerun this wrapper call with host approval or outside the sandbox. Headless Codex runs with approvals off cannot do this." >&2
      exit 3
    fi
    echo "plx-engine: Claude credentials unavailable — if Claude works in a local terminal, retry this wrapper with narrowly scoped host approval; otherwise run \`claude /login\`." >&2
    exit 3
  fi
  if [[ "$claude_rc" -ne 0 ]]; then
    echo "claude invocation failed" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi
  [[ -s "$OUT" ]] || { echo "claude produced empty output: $OUT" >&2; exit 1; }
}

run_devin() {
  local config export_file raw auth_log parser_log devin_prompt auth_rc rc retryable=0 auth_failure=0

  # Never preserve a prior successful answer when any validation or invocation
  # step fails, including missing binary and authentication checks.
  : > "$OUT"
  : > "$LOG"
  command -v devin >/dev/null 2>&1 || {
    echo "plx-engine: Devin CLI not found — install it and run \`devin auth login\`, then retry." >&2
    exit 1
  }

  config="$TMP_DIR/devin-config.json"
  export_file="$TMP_DIR/devin-export.json"
  raw="$TMP_DIR/devin-stdout.log"
  auth_log="$TMP_DIR/devin-auth.log"
  parser_log="$TMP_DIR/devin-parser.log"
  devin_prompt="$TMP_DIR/devin-prompt.md"
  cat > "$config" <<'JSON'
{
  "permissions": {"allow": [], "deny": [], "ask": []},
  "read_config_from": {"cursor": false, "windsurf": false, "claude": false},
  "subagents_enabled": false,
  "auto_update": false,
  "attribution": false,
  "show_hints": false,
  "notify": "never",
  "theme_mode": "nocolor"
}
JSON

  cat "$EXEC_PROMPT" > "$devin_prompt"
  printf '\n\n## Parallax runtime boundary\n' >> "$devin_prompt"
  printf '%s\n' \
    'Devin has full host access. Before inspecting or changing a path, read the listed guidance that governs it. Root files apply repo-wide; nested files and rule files apply only to their subtree or declared paths. Full access does not expand the task; publication, deployment, credential changes, and external-system mutations require the user to authorize the exact action and target.' \
    >> "$devin_prompt"
  list_guidance '*/.devin/rules/*.md' '*/.devin/skills/*/SKILL.md' >> "$devin_prompt"

  set +e
  env -u DEVIN_SANDBOX devin --config "$config" auth status > "$auth_log" 2>&1
  auth_rc=$?
  set -e
  if [[ $auth_rc -ne 0 ]]; then
    if grep -qiE 'not logged in|please log in|authentication required|no credentials|devin auth login' "$auth_log"; then
      echo "plx-engine: Devin not authenticated — run \`devin auth login\`, then retry." >&2
      exit 3
    fi
    echo "plx-engine: \`devin auth status\` failed (exit $auth_rc)" >&2
    exit 1
  fi

  # Signal Devin's process group, then wait up to 2s for it to exit.
  devin_stop() {
    local tries=0
    [[ -n "${DEVIN_PID:-}" ]] || return 0
    kill "-$1" -- "-$DEVIN_PID" 2>/dev/null
    kill "-$1" "$DEVIN_PID" 2>/dev/null
    devin_state="$(ps -o stat= -p "$DEVIN_PID" 2>/dev/null || true)"
    while [[ -n "$devin_state" && "$devin_state" != Z* && "$tries" -lt 40 ]]; do
      sleep 0.05
      tries=$((tries + 1))
      devin_state="$(ps -o stat= -p "$DEVIN_PID" 2>/dev/null || true)"
    done
  }

  devin_interrupt() {
    local devin_state=""
    trap - INT TERM
    set +e
    devin_stop TERM
    devin_stop KILL
    if [[ -n "$devin_state" && "$devin_state" != Z* ]]; then
      echo "plx-engine: Devin invocation interrupted; could not confirm that the owned process tree stopped" >&2
    else
      [[ -n "${DEVIN_PID:-}" ]] && wait "$DEVIN_PID" 2>/dev/null
      echo "plx-engine: Devin invocation interrupted; the owned process tree was stopped and will not be retried" >&2
    fi
    exit 1
  }

  set +e
  DEVIN_PID=""
  trap devin_interrupt INT TERM
  (
    cd "$REPO" || exit 1
    exec python3 -c \
      'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' \
      env -u DEVIN_SANDBOX devin --config "$config" \
      --permission-mode dangerous --respect-workspace-trust false --model "$MODEL" \
      --prompt-file "$devin_prompt" --export "$export_file" -p </dev/null
  ) > "$raw" 2> "$LOG" &
  DEVIN_PID=$!
  wait "$DEVIN_PID"
  rc=$?
  DEVIN_PID=""
  trap - INT TERM
  set -e

  # Only native stderr can classify a retry. Model stdout and exported answers
  # may quote errors. Require the exact provider diagnostic and JSON boolean.
  if [[ $rc -ne 0 && $rc -lt 128 ]] && python3 - "$LOG" <<'PY_RETRY'
import json
import re
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(errors="replace")
matches = list(re.finditer(
    r"^Error: Agent error: Client error: Protocol error \(invalid_argument\): "
    r"an internal error occurred \(trace ID: [0-9a-f]+\): ",
    text, re.MULTILINE,
))
try:
    # Repeated copies are allowed; trailing errors or hints still fail closed.
    detail = json.loads(text[matches[-1].end():]) if matches else {}
except json.JSONDecodeError:
    detail = {}
sys.exit(0 if isinstance(detail, dict)
         and detail.get("cognition.ai/errorKind") == "internal"
         and detail.get("cognition.ai/retryable") is True else 1)
PY_RETRY
  then
    retryable=1
  fi
  if grep -qiE 'not logged in|please log in|authentication required|no credentials|devin auth login' "$LOG"; then
    auth_failure=1
  fi

  if [[ -s "$raw" ]]; then
    printf '\n%s\n' '--- Devin print stdout ---' >> "$LOG"
    cat "$raw" >> "$LOG"
  fi
  if [[ $rc -ne 0 ]]; then
    if [[ "$auth_failure" -eq 1 ]]; then
      echo "plx-engine: Devin not authenticated — run \`devin auth login\`, then retry." >&2
      exit 3
    fi
    if [[ "$retryable" -eq 1 ]]; then
      echo "plx-engine: Devin retryable internal protocol failure (exit $rc); inspect partial work before a bounded retry" >&2
      [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
      exit 4
    fi
    echo "Devin invocation failed (exit $rc)" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi

  if ! python3 - "$export_file" "$OUT" > "$parser_log" 2>&1 <<'PY_ATIF'
import json
import sys
from pathlib import Path

export_path = Path(sys.argv[1])
output_path = Path(sys.argv[2])

try:
    document = json.loads(export_path.read_text())
except (OSError, json.JSONDecodeError) as exc:
    raise SystemExit(f"missing or malformed Devin ATIF export: {exc}")

if document.get("schema_version") != "ATIF-v1.7":
    raise SystemExit(f"unsupported Devin ATIF schema: {document.get('schema_version')!r}")

steps = document.get("steps")
if not isinstance(steps, list) or not steps:
    raise SystemExit("Devin ATIF export has no steps")

terminal = steps[-1]
if not isinstance(terminal, dict) or terminal.get("source") != "agent":
    raise SystemExit("Devin ATIF export has no terminal agent response")
if terminal.get("tool_calls") not in (None, []):
    raise SystemExit("Devin ATIF export ended on a pending or denied tool call")

message = terminal.get("message")
if not isinstance(message, str) or not message.strip():
    raise SystemExit("Devin ATIF terminal response is empty")

output_path.write_text(message.rstrip() + "\n")
PY_ATIF
  then
    echo "plx-engine: Devin completed without a valid terminal response" >&2
    [[ -s "$parser_log" ]] && sed -n '1,20p' "$parser_log" >&2
    exit 1
  fi
}

run_grok() {
  local sandbox raw rc stop
  [[ "$MODE" == "ro" ]] && sandbox="read-only" || sandbox="workspace"
  raw="$TMP_DIR/raw.json"

  set +e
  grok --no-auto-update --cwd "$REPO" \
    --model "$MODEL" --effort "$EFFORT" \
    --permission-mode bypassPermissions --sandbox "$sandbox" \
    --no-plan --no-subagents --no-memory --no-alt-screen --output-format json \
    --prompt-file "$EXEC_PROMPT" > "$raw" 2> "$LOG"
  rc=$?
  set -e

  # Genuine "not signed in" prints the OAuth sign-in prompt to stderr. This is
  # the real login signal — NOT the AuthorizationRequired worker noise, which
  # also appears on success.
  if grep -qiE "Open this URL to sign in|Signing in with Grok" "$LOG"; then
    echo "plx-engine: grok not authenticated — run \`grok login\` (or export XAI_API_KEY), then retry." >&2
    exit 3
  fi

  if [[ $rc -ne 0 ]]; then
    if grep -qiE \
      '(seatbelt.*(fail|denied|operation not permitted)|(fail|denied|operation not permitted).*seatbelt|sandbox(_init| initialization| setup).*(fail|denied|operation not permitted)|(fail|denied|operation not permitted).*(sandbox_init|sandbox initialization|sandbox setup))' \
      "$LOG"; then
      echo "PLX_GROK_SANDBOX_UNAVAILABLE" >&2
      echo "Grok $sandbox sandbox could not initialize under the host sandbox." >&2
      echo "The Grok lane did not start. Do not perform or attribute the task to this lane." >&2
      [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
      exit 1
    fi
    echo "grok invocation failed (exit $rc)" >&2
    [[ -s "$LOG" ]] && sed -n '1,40p' "$LOG" >&2
    exit 1
  fi

  stop="$(python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("stopReason") or "")
except Exception: print("")' "$raw")"
  if [[ "$stop" == "cancelled" || "$stop" == "Cancelled" ]]; then
    echo "plx-engine: grok turn was cancelled — a tool call was gated, not auto-approved." >&2
    exit 1
  fi
  python3 -c 'import json,sys
try: sys.stdout.write(json.load(open(sys.argv[1])).get("text") or "")
except Exception: sys.stdout.write(open(sys.argv[1]).read())' "$raw" > "$OUT"
  [[ -s "$OUT" ]] || { echo "plx-engine: grok empty output (stopReason=$stop)" >&2; exit 1; }
  printf '\n' >> "$OUT"

  # Headless one-shot runs never resume; drop this run's session dir so
  # ~/.grok/sessions doesn't grow without bound (grok has no --ephemeral).
  # Failure paths exit above and keep the session for debugging.
  python3 -c 'import json,os,shutil,sys,urllib.parse
try:
    sid = json.load(open(sys.argv[1])).get("sessionId") or ""
    if not sid:
        sys.exit(0)
    repo = os.path.realpath(sys.argv[2])
    d = os.path.join(os.path.expanduser("~/.grok/sessions"),
                     urllib.parse.quote(repo, safe=""), sid)
    if os.path.isdir(d):
        shutil.rmtree(d)
        parent = os.path.dirname(d)
        if os.listdir(parent) in ([], ["prompt_history.jsonl"]):
            shutil.rmtree(parent)
except Exception:
    pass' "$raw" "$REPO" || true
}

# --------------------------------------------------------------------------- #
# Gemini transport
# --------------------------------------------------------------------------- #

run_gemini() {
  local settings raw rc approval sandbox
  : > "$OUT"
  command -v gemini >/dev/null 2>&1 || {
    echo "plx-engine: Gemini CLI not found; install @google/gemini-cli and authenticate with gemini" >&2
    exit 1
  }
  settings="$TMP_DIR/gemini-settings.json"
  raw="$TMP_DIR/gemini-response.json"
  approval="default"
  [[ "$MODE" == "rw" ]] && approval="auto_edit"
  case "$(uname -s)" in
    Darwin) sandbox="sandbox-exec" ;;
    *) echo "plx-engine: Gemini transport currently requires macOS Seatbelt" >&2; exit 1 ;;
  esac
  # System settings override user/project customization without replacing auth.
  # Reject inherited extra workspace roots; Gemini concatenates these settings.
  python3 - "$settings" "$MODE" "$REPO" <<'PY_SETTINGS'
import json
import sys
from pathlib import Path

for source in [Path.home() / ".gemini/settings.json", Path(sys.argv[3]) / ".gemini/settings.json"]:
    if source.exists():
        try:
            existing = json.loads(source.read_text())
        except (ValueError, OSError):
            raise SystemExit(f"plx-engine: cannot validate Gemini workspace roots in {source}; plain JSON settings required")
        if existing.get("includeDirectories") or (existing.get("context") or {}).get("includeDirectories"):
            raise SystemExit(f"plx-engine: Gemini extra includeDirectories are unsupported: {source}")
core = ["read_file", "read_many_files", "list_directory", "glob", "search_file_content"]
if sys.argv[2] == "rw":
    core += ["replace", "write_file"]
Path(sys.argv[1]).write_text(json.dumps({
    "tools": {"core": core, "allowed": [], "sandbox": True,
              "discoveryCommand": "", "callCommand": "", "enableHooks": False},
    "context": {"includeDirectories": []}, "mcpServers": {},
    "mcp": {"serverCommand": "", "allowed": ["plx-disabled-" + Path(sys.argv[1]).parent.name]},
    "skills": {"enabled": False}, "hooksConfig": {"enabled": False},
    "admin": {"mcp": {"enabled": False}, "extensions": {"enabled": False}},
    "experimental": {"enableAgents": False},
    "general": {"enableAutoUpdate": False},
    "telemetry": {"enabled": False}, "privacy": {"usageStatisticsEnabled": False}
}))
PY_SETTINGS
  set +e
  (
    cd "$REPO" || exit 1
    unset SANDBOX SANDBOX_FLAGS SANDBOX_MOUNTS SANDBOX_ENV BUILD_SANDBOX
    unset GEMINI_SANDBOX_PROXY_COMMAND GEMINI_SYSTEM_MD
    export GEMINI_CLI_SYSTEM_SETTINGS_PATH="$settings" GEMINI_CLI_SYSTEM_DEFAULTS_PATH="$settings"
    export GEMINI_SANDBOX="$sandbox" SEATBELT_PROFILE="permissive-open"
    gemini --sandbox --extensions none --approval-mode "$approval" \
      --model "$MODEL" --output-format json < "$EXEC_PROMPT"
  ) > "$raw" 2> "$LOG"
  rc=$?
  set -e
  cat "$raw" >> "$LOG"
  if [[ "$rc" -ne 0 ]]; then
    if grep -qiE 'Please set an Auth method|Please set.*GEMINI_API_KEY|not authenticated|invalid API key|API key not valid|authentication required|ProjectIdRequiredError|Error authenticating' "$LOG"; then
      echo "plx-engine: Gemini authentication unavailable; run gemini to sign in or configure GEMINI_API_KEY" >&2
      tail -20 "$LOG" >&2
      exit 3
    fi
    echo "plx-engine: Gemini invocation failed (exit $rc); see log: $LOG" >&2
    tail -20 "$LOG" >&2
    exit 1
  fi
  if ! python3 - "$raw" "$OUT" <<'PY_RESPONSE'
import json
import sys
from pathlib import Path

try:
    data = json.loads(Path(sys.argv[1]).read_text())
    if not isinstance(data, dict) or data.get("error"):
        raise ValueError("Gemini returned an error envelope")
    response = data.get("response")
    if not isinstance(response, str) or not response.strip():
        raise ValueError("Gemini returned no final response")
    Path(sys.argv[2]).write_text(response.rstrip() + "\n")
except (ValueError, OSError) as error:
    print(f"plx-engine: invalid Gemini response: {error}", file=sys.stderr)
    sys.exit(1)
PY_RESPONSE
  then
    exit 1
  fi
}

case "$ENGINE" in
  codex) run_codex ;;
  claude) run_claude ;;
  devin) run_devin ;;
  grok) run_grok ;;
  gemini) run_gemini ;;
esac

if [[ "$STDOUT" -eq 1 ]]; then
  cat "$OUT"
else
  echo "OK plx-engine engine=$ENGINE mode=$MODE out=$OUT log=$LOG"
fi
}

# --------------------------------------------------------------------------- #
# Entry point
# --------------------------------------------------------------------------- #

main "$@"
