#!/usr/bin/env bash
set -euo pipefail

# Parallax engine API — preflight. Probes engine availability FOR REAL: sends a
# tiny prompt through plx-engine (mode ro), so it verifies install + auth +
# model in one shot (a `command -v` check can't catch a broken auth or model).

usage() {
  cat <<'EOF'
plx-preflight — probe external engine availability before a Parallax pipeline runs

Usage:
  plx-preflight --repo <abs-path> [--require-codex] [--require-grok] [--require-claude]
                [--optional-codex] [--optional-grok] [--optional-claude]
                [--grok-mode ro|rw]

What it does:
  For each requested engine, sends a tiny "reply OK" prompt through
  `plx-engine`. A passing probe proves the CLI is installed, authenticated, the
  model responds, and the selected sandbox profile starts. Grok defaults to a
  read-only probe; `--grok-mode rw` validates its workspace writer sandbox
  against a disposable directory. All probe artifacts live in a temp dir and
  are deleted on exit.

Flags:
  --repo <dir>         absolute path to the target repo (required)
  --require-<engine>   probe the engine; fail preflight if it doesn't pass
  --optional-<engine>  probe the engine; report but don't fail
  --grok-mode <mode>   ro (default) | rw; requires a Grok selector
  --help               this text

Output (stdout):
  ### Parallax preflight
  - repo: <path>
  - <engine>: ok | missing | probe failed   (Grok also reports mode)
  - preflight_ok: yes | no

Exit codes:
  0  all required engines passed
  1  a required engine is missing or failed its probe
  2  usage error
EOF
}

REPO=""
REQUIRE_CODEX=0; OPTIONAL_CODEX=0
REQUIRE_GROK=0;  OPTIONAL_GROK=0
REQUIRE_CLAUDE=0; OPTIONAL_CLAUDE=0
GROK_MODE="ro"; GROK_MODE_SET=0

need_value() { [[ -n "${2:-}" ]] || { echo "missing value for $1" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) need_value "$1" "${2:-}"; REPO="$2"; shift 2 ;;
    --require-codex) REQUIRE_CODEX=1; shift ;;
    --optional-codex) OPTIONAL_CODEX=1; shift ;;
    --require-grok) REQUIRE_GROK=1; shift ;;
    --optional-grok) OPTIONAL_GROK=1; shift ;;
    --grok-mode) need_value "$1" "${2:-}"; GROK_MODE="$2"; GROK_MODE_SET=1; shift 2 ;;
    --require-claude) REQUIRE_CLAUDE=1; shift ;;
    --optional-claude) OPTIONAL_CLAUDE=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
  esac
done

[[ -n "$REPO" ]] || { echo "--repo required" >&2; exit 2; }
[[ -d "$REPO" ]] || { echo "repo not found: $REPO" >&2; exit 2; }
case "$GROK_MODE" in ro|rw) ;; *) echo "--grok-mode must be ro|rw" >&2; exit 2 ;; esac
if [[ "$GROK_MODE_SET" -eq 1 && "$REQUIRE_GROK" -eq 0 && "$OPTIONAL_GROK" -eq 0 ]]; then
  echo "--grok-mode requires --require-grok or --optional-grok" >&2
  exit 2
fi
REPO="$(cd "$REPO" && pwd)"
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/plx-preflight.XXXXXX")"
plx_preflight_exit() {
  local rc=$?
  set +e
  "$BIN_DIR/plx-clean-temp" "$TMP_DIR"
  trap - EXIT
  exit "$rc"
}
trap plx_preflight_exit EXIT
mkdir -p "$TMP_DIR"/{prompts,outputs,logs}

STATUS=0
CODEX_OK=0
GROK_OK=0
CLAUDE_OK=0

print_log_tail() {
  local log_file="$1"
  [[ -s "$log_file" ]] || return 0
  echo "  log tail:"
  sed -n '1,20p' "$log_file" | sed 's/^/  > /'
}

probe() {
  local engine="$1" mode="ro" probe_repo="$REPO"
  if ! command -v "$engine" >/dev/null 2>&1; then
    if [[ "$engine" == "grok" ]]; then
      echo "- $engine: missing (mode=$GROK_MODE)"
    else
      echo "- $engine: missing"
    fi
    return 1
  fi

  printf '%s\n' "reply OK" > "$TMP_DIR/prompts/$engine-probe.md"
  if [[ "$engine" == "grok" ]]; then
    mode="$GROK_MODE"
    if [[ "$mode" == "rw" ]]; then
      probe_repo="$TMP_DIR/grok-workspace-probe"
      mkdir -p "$probe_repo"
      printf '%s\n' \
        'Reply with exactly OK. Do not call tools or modify files.' \
        > "$TMP_DIR/prompts/$engine-probe.md"
    fi
  fi
  # Keep non-Grok probes cheap. Grok omits the flag so preflight validates its
  # pinned grok-4.6 / medium default. Bash 3.2 + set -u needs the guard idiom.
  local -a extra
  [[ "$engine" != "grok" ]] && extra=(--effort low)
  if "$BIN_DIR/plx-engine" --engine "$engine" --mode "$mode" \
    --repo "$probe_repo" \
    --prompt-file "$TMP_DIR/prompts/$engine-probe.md" \
    --out "$TMP_DIR/outputs/$engine-probe.md" \
    --log "$TMP_DIR/logs/$engine-probe.log" \
    ${extra[@]+"${extra[@]}"} >/dev/null && [[ -s "$TMP_DIR/outputs/$engine-probe.md" ]]; then
    if [[ "$engine" == "grok" ]]; then
      echo "- $engine: ok (mode=$mode)"
    else
      echo "- $engine: ok"
    fi
    case "$engine" in
      codex) CODEX_OK=1 ;;
      grok) GROK_OK=1 ;;
      claude) CLAUDE_OK=1 ;;
    esac
    return 0
  fi

  if [[ "$engine" == "grok" ]]; then
    echo "- $engine: probe failed (mode=$mode)"
  else
    echo "- $engine: probe failed"
  fi
  print_log_tail "$TMP_DIR/logs/$engine-probe.log"
  return 1
}

echo "### Parallax preflight"
echo "- repo: $REPO"
echo "- temp_artifacts: ephemeral"

if [[ "$REQUIRE_CODEX" -eq 1 ]]; then probe codex || STATUS=1
elif [[ "$OPTIONAL_CODEX" -eq 1 ]]; then probe codex || true; fi

if [[ "$REQUIRE_GROK" -eq 1 ]]; then probe grok || STATUS=1
elif [[ "$OPTIONAL_GROK" -eq 1 ]]; then probe grok || true; fi

if [[ "$REQUIRE_CLAUDE" -eq 1 ]]; then probe claude || STATUS=1
elif [[ "$OPTIONAL_CLAUDE" -eq 1 ]]; then probe claude || true; fi

echo "- preflight_ok: $([[ "$STATUS" -eq 0 ]] && echo yes || echo no)"
echo "- codex_ok: $([[ "$CODEX_OK" -eq 1 ]] && echo yes || echo no)"
echo "- grok_ok: $([[ "$GROK_OK" -eq 1 ]] && echo yes || echo no)"
echo "- claude_ok: $([[ "$CLAUDE_OK" -eq 1 ]] && echo yes || echo no)"
exit "$STATUS"
