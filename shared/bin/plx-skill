#!/usr/bin/env bash
set -euo pipefail

# Parallax engine API — skill reader. Prints a sibling pipeline skill
# without needing a plugin-root path.

usage() {
  cat <<'EOF'
plx-skill — print a Parallax pipeline skill file

Usage:
  plx-skill <name>             print skills/<name>/SKILL.md (e.g. plx-skill dev)
  plx-skill --ref <skill>/<n>  print skills/<skill>/references/<n>.md (e.g. plan/spec-template)
  plx-skill --list             list available skill names

Exit codes:
  0  printed
  1  no such skill or reference
  2  usage error
EOF
}

# Resolve symlinks so --ref works when the tool is reached via a PATH symlink.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
BIN_DIR="$(cd -P "$(dirname "$src")" && pwd)"
SKILLS_DIR="$BIN_DIR/../skills"

case "${1:-}" in
  "") usage >&2; exit 2 ;;
  --help|-h) usage; exit 0 ;;
  --list)
    for d in "$SKILLS_DIR"/*/; do
      name="$(basename "$d")"
      [[ "$name" == _* ]] && continue
      [[ -f "$d/SKILL.md" ]] && echo "$name"
    done
    exit 0 ;;
  --ref)
    ref="${2:-}"
    [[ -n "$ref" && "$ref" == */* ]] || { echo "usage: plx-skill --ref <skill>/<name> (e.g. plan/spec-template)" >&2; exit 2; }
    REF="$SKILLS_DIR/${ref%/*}/references/${ref##*/}.md"
    [[ -f "$REF" ]] || { echo "no such reference: $ref (looked at $REF)" >&2; exit 1; }
    cat "$REF"
    exit 0 ;;
  --*) echo "unknown arg: $1 (see --help)" >&2; exit 2 ;;
esac

SKILL="$SKILLS_DIR/$1/SKILL.md"
[[ -f "$SKILL" ]] || { echo "no such skill: $1 (try plx-skill --list)" >&2; exit 1; }
cat "$SKILL"
